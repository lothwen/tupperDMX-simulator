# ABOUTME: Kernel options the app needs on top of board/pc/linux.config, which
# ABOUTME: is a 90-line minimal config carrying USB storage and onboard HDA
# ABOUTME: audio but no USB serial and no MIDI of any kind.
#
# Merged in through BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES, so buildroot's own
# board/pc/linux.config stays untouched and upgradeable.

#
# USB serial: how the DMX dongle appears
#
# dmx/usb_worker.py resolves an FTDI serial number (VID 0x0403) to /dev/ttyUSB*
# and opens it at 250000 baud, 8N2 -- DMX512 on the wire. Without ftdi_sio the
# dongle never enumerates as a tty, so list_ports.comports() returns nothing and
# the worker fails with "No FTDI serial port found" no matter what is plugged in.
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
# The other bridge chips found on serial gear that ends up in a rack: not used
# by the DMX path, which is FTDI-only, but a few KB each and the difference
# between "works" and "a device night that needs a kernel rebuild".
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CH341=y
# CDC-ACM: Arduino-class boards and anything exposing a USB modem interface.
CONFIG_USB_ACM=y

#
# MIDI
#
# python-rtmidi speaks to the ALSA *sequencer*, not to raw devices, so without
# this there are no MIDI ports at all -- the software controller has nothing to
# bind to and no hardware controller can reach it.
CONFIG_SND_SEQUENCER=y
# snd-usb-audio drives USB MIDI controllers and USB audio interfaces alike; the
# stock config only has onboard HDA. CONFIG_SND_USB alone is just the menu gate.
CONFIG_SND_USB_AUDIO=y

#
# Storage
#
# board/pc/linux.config drives ATA and USB storage and nothing else, so an NVMe
# disk does not appear at all. That is not a comfort choice: the box read a cold
# 15 MB backing track off a USB SD reader at 0.2 MB/s -- 95 seconds -- and since
# QAudioDecoder blocks on that read, the song joins the timeline late and the
# web remote gives up on its waveform ("nothing decoded after 20s"). The same
# image on NVMe decodes that file in 0.84 s; the decoder was never the problem.
# Built in rather than a module, because the root filesystem is on it and this
# image has no initramfs. Selects NVME_CORE on its own, and PCI is already on.
CONFIG_BLK_DEV_NVME=y

#
# Timers
#
# board/pc/linux.config sets no timer options at all, so the kernel falls back
# to CONFIG_HZ_PERIODIC at CONFIG_HZ=250 and every userspace timer rounds up to
# the 4 ms tick. Most of the app rides that grid without noticing: the 15 ms
# audio feed and the 20 ms playback tick are both several ticks long, and MIDI
# is dispatched off the latter into a queue, so it is quantised to 50 ms by the
# design and not by the kernel.
#
# The metronome is the one thing that pays. app/audio_controller.py re-arms a
# single-shot QTimer for every beat, deriving the delay from an absolute
# next_beat_expected_time, so accumulated drift is corrected and STAYS
# corrected -- what the tick costs is the individual beat, which fires at the
# next 4 ms boundary and so lands up to 4 ms late. The backing track has no
# equivalent error, because its timing is sample offsets inside the mixer's
# buffer; the click therefore wobbles against a rock-steady backing, which is
# precisely the comparison the player on stage is making.
#
# Selects TICK_ONESHOT, i.e. the tick becomes programmable instead of periodic.
# Nothing else in this fragment depends on it.
CONFIG_HIGH_RES_TIMERS=y
