#!/bin/sh
#
# Start/stop the TupperDMX Simulator in headless mode.
#
# Headless is the SBC/rack mode: no GUI at all, the embedded web remote is the
# only interface. S99 puts it last on purpose -- it needs S41dhcpcd (an address
# to serve the remote on) and S50pulseaudio (QtMultimedia's audio backend is
# libpulse) already running.
#

# Buildroot's own python3; the dependencies are installed into its
# site-packages by post-build.sh. main.py's directory goes on sys.path by
# virtue of being the script, so /opt/tupperdmx needs no PYTHONPATH.
DAEMON=/usr/bin/python3
APP=/opt/tupperdmx/main.py
# HOME *and* working directory. config.logging.log_dir is relative, so the logs
# land in $DATA_DIR/logs; userprefs.json goes to $DATA_DIR/.config and the show
# projects to $DATA_DIR/Documents/TupperDMX. One writable place, easy to back up.
DATA_DIR=/var/lib/tupperdmx
PIDFILE=/var/run/tupperdmx.pid
# Everything the app writes to stdout/stderr, this run only (truncated on each
# start): the console half of the logging system, plus anything that dies before
# it comes up. logs/ is the rotated history; this is the current boot.
BOOTLOG=$DATA_DIR/boot.log
# pulseaudio runs in system mode (see S50pulseaudio), so name its socket rather
# than relying on the client's per-user runtime path, which root does not have.
PULSE_SERVER=unix:/var/run/pulse/native
export PULSE_SERVER

# Nothing to do if the post-build step never populated /opt/tupperdmx.
[ -x "$DAEMON" ] || exit 0
[ -f "$APP" ] || exit 0

start() {
	printf 'Starting tupperdmx: '
	mkdir -p "$DATA_DIR"
	cd "$DATA_DIR" || { echo 'FAIL (no data dir)'; exit 1; }
	# -b backgrounds it and -m writes the pidfile: main.py --headless runs a
	# Qt event loop in the foreground until it is signalled.
	#
	# Run it through a shell that reopens $BOOTLOG and then execs, rather than
	# redirecting this command: -b hands the daemon /dev/null on all three
	# standard descriptors, so a redirection out here captures nothing the app
	# ever says. That is not a cosmetic loss -- an ImportError, a missing
	# shared library or a traceback raised before the logging system is up has
	# NOWHERE else to go, and the box comes up looking like a clean boot that
	# simply ignores its preferences. `exec` twice keeps the pid start-stop-
	# daemon recorded with -m, so -K and the status check still find it.
	#
	# -N -5 raises the app above everything else that shares the box. This is
	# insurance, not a scheduling fix: the audio feed sits behind a 120 ms
	# buffer topped up every 15 ms and MIDI is dispatched on a 20 Hz tick, so
	# no plausible scheduler delay reaches either, and there is normally
	# nothing to compete with anyway -- dhcpcd, pulseaudio and samba are all
	# idle during a show. It is the abnormal case that this buys: a samba copy
	# of the next set's backing tracks landing mid-song is the one thing on
	# this image that can saturate the machine.
	#
	# Applied to the /bin/sh below rather than to python, because nice levels
	# survive exec -- both execs inherit it. Negative levels need uid 0, which
	# this script has at boot; -N is busybox's start-stop-daemon FANCY option,
	# enabled in the buildroot config.
	#
	# --dmx-usb auto sends the controller's DMX out of whatever FTDI dongle is
	# plugged in, resolved at every boot. The box has no Settings dialog, so the
	# alternative is writing the device's "manufacturer:product:serial" string
	# into userprefs.json by hand -- and that string changes with the dongle, so
	# a replacement at the venue would leave the rig dark until someone edits
	# the file over the share. The pick is NOT written back to userprefs.json:
	# it is a fact about tonight's hardware, not a preference. With nothing
	# plugged in the USB output simply stays off and the box boots as usual
	# (Art-Net and the web remote do not depend on it). Add --show ... here too
	# to pin one show; see buildroot/README.md.
	#
	HOME="$DATA_DIR" \
	start-stop-daemon -S -q -b -m -N -5 -p "$PIDFILE" \
		-x /bin/sh -- -c "exec >'$BOOTLOG' 2>&1; exec '$DAEMON' '$APP' --headless --dmx-usb auto"
	if [ $? -ne 0 ]; then echo 'FAIL (start-stop-daemon)'; return 1; fi
	# The daemon is backgrounded, so its exit status never reaches this script:
	# without this check a process that dies on startup still prints OK, which
	# is exactly how a crash-on-boot stayed invisible.
	sleep 2
	if start-stop-daemon -K -t -q -p "$PIDFILE"; then
		echo 'OK'
	else
		echo "FAIL (died on startup -- see $BOOTLOG)"
		return 1
	fi
}

stop() {
	printf 'Stopping tupperdmx: '
	# SIGTERM is the clean path: run_headless() catches it and runs the same
	# shutdown as closing the window, which flushes the pending .mid autosave.
	# Busybox start-stop-daemon has no --retry, so wait for the flush here.
	start-stop-daemon -K -q -p "$PIDFILE"
	i=0
	while [ $i -lt 20 ] && start-stop-daemon -K -t -q -p "$PIDFILE"; do
		sleep 1
		i=$((i + 1))
	done
	rm -f "$PIDFILE"
	echo 'OK'
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	stop
	start
	;;
  status)
	if start-stop-daemon -K -t -q -p "$PIDFILE"; then
		echo "tupperdmx running (pid $(cat "$PIDFILE"))"
	else
		echo 'tupperdmx not running'
		exit 1
	fi
	;;
  *)
	echo "Usage: $0 {start|stop|restart|status}"
	exit 1
esac

exit $?
