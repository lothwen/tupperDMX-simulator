/* TupperDMX Simulator Dark Theme */

/* Main Splitter */
QSplitter {
    border: none;
    background-color: #2b2b2b;
}

QSplitter::handle {
    background-color: #444444;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Timeline Widget */
#Timeline {
    border: none;
    background-color: #2b2b2b;
}

/* Graphics View (Stage) */
QGraphicsView {
    border: none;
    background-color: #2b2b2b;
}

/* Timeline Tooltip */
#TimelineTooltip {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* Beat Detection Dialog */
QDialog {
    background-color: #2b2b2b;
    color: white;
}

QDialog QLabel {
    color: white;
}

QDialog QPushButton {
    background-color: #555;
    color: white;
    border: 1px solid #666;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 12px;
}

QDialog QPushButton:hover {
    background-color: #666;
}

QDialog QPushButton:pressed {
    background-color: #444;
}

/* File open Dialog */
QFileDialog QTreeView,
QFileDialog QListView,
QFileDialog QLineEdit {
    background-color: #2b2b2b;
    color: white;
}

/* Context Menus */
QMenu {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    padding: 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 8px 16px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #4a5568;
}

QMenu::item:disabled {
    color: #666;
}

QMenu::separator {
    height: 1px;
    background-color: #555;
    margin: 2px 0;
}

/* Mute Buttons */
#MetronomeMuteButton, #AudioMuteButton {
    color: white;
    border: none;
    border-radius: 2px;
}

#MetronomeMuteButton:checked, #AudioMuteButton:checked {
    background-color: red;
    color: white;
}

/* Toolbar Metronome Button */
#MetronomeButton {
    /*border: 1px solid #555555;*/
    border-radius: 3px;
    background-color: #404040;
    padding: 2px;
}

#MetronomeButton:hover {
    background-color: #505050;
    border-color: #777777;
}

#MetronomeButton:checked {
    background-color: #ff4444;
    border-color: #ff6666;
}

#MetronomeButton:checked:hover {
    background-color: #ff6666;
    border-color: #ff8888;
}

/* Control Containers */
#MetronomeControlsContainer, #AudioControlsContainer {
    background-color: #383838;
    border-radius: 5px;
}

/* DMX Display Table */
QTableWidget {
    background-color: #2B2B2B;
    color: white;
    gridline-color: #444444;
    border: 1px solid #444444;
    alternate-background-color: #333333;
    selection-background-color: #4A5568;
}

QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #4A5568;
    color: white;
}

QHeaderView::section {
    background-color: #3A3A3A;
    color: white;
    padding: 4px 8px;
    border: 1px solid #444444;
    font-weight: bold;
}

QHeaderView::section:horizontal {
    border-left: none;
}

QHeaderView::section:vertical {
    border-top: none;
}

/* Toolbar */
QToolBar {
    background-color: #2b2b2b;
    border: none;
    spacing: 5px;
    padding: 5px;
}

/* Toolbar Sections */
QFrame#ToolbarSection {
    background-color: #3a3a3a;
    border: 1px solid #555;
    border-radius: 8px;
    margin: 2px;
}

/* Section Titles */
QLabel#SectionTitle {
    background-color: #2b2b2b;
    border-radius: 6px;
    color: #aaa;
    font-size: 14px;
    font-weight: bold;
}

QLabel#SubsectionLabel {
    background-color: #3a3a3a;
    color: #aaa;
    font-size: 12px;
    font-weight: normal;
}

QLabel#SmallLabel {
    color: #aaa;
    font-size: 12px;
}

/* Load Buttons */
QPushButton#LoadButton {
    background-color: #555;
    color: white;
    border: 1px solid #666;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#LoadButton:hover {
    background-color: #666;
}

QPushButton#LoadButton:pressed {
    background-color: #444;
}

/* New Button */
QPushButton#NewButton {
    background-color: #2d5016;
    color: white;
    border: 1px solid #3d6026;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#NewButton:hover {
    background-color: #3d6026;
}
QPushButton#NewButton:pressed {
    background-color: #1d4006;
}

/* Export Button */
QPushButton#ExportButton {
    background-color: #4a5568;
    color: white;
    border: 1px solid #5a6578;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#ExportButton:hover {
    background-color: #5a6578;
}

QPushButton#ExportButton:pressed {
    background-color: #3a4558;
}

QPushButton#ExportButton:disabled {
    background-color: #333;
    color: #666;
    border-color: #444;
}

/* Playlist Navigation Buttons */
QPushButton#NavButton {
    background-color: #4a5568;
    color: white;
    border: 1px solid #5a6578;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background-color: #5a6578;
}

QPushButton#NavButton:pressed {
    background-color: #3a4558;
}

QPushButton#NavButton:disabled {
    background-color: #333;
    color: #555;
    border-color: #444;
}

/* Remove Song Button */
QPushButton#RemoveButton {
    background-color: #6b3030;
    color: white;
    border: 1px solid #7b4040;
    border-radius: 6px;
    font-size: 14px;
}

QPushButton#RemoveButton:hover {
    background-color: #8b4040;
}

QPushButton#RemoveButton:pressed {
    background-color: #5b2020;
}

/* Song Counter Label */
QLabel#SongCounter {
    background-color: #1a1a1a;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
}

/* File Labels */
QLabel#FileLabel {
    background-color: #2b2b2b;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 2px 12px;
    font-size: 11px;
}

/* Transport Buttons */
QPushButton#StopButton {
    background-color: #555;
    color: white;
    border: 1px solid #666;
    border-radius: 8px;
    padding: 8px;
}

QPushButton#StopButton:hover {
    background-color: #666;
}

QPushButton#StopButton:pressed {
    background-color: #444;
}

QPushButton#PlayPauseButton {
    background-color: #4CAF50;
    color: white;
    border: 2px solid #45a049;
    border-radius: 25px;
}

QPushButton#PlayPauseButton:hover {
    background-color: #45a049;
}

QPushButton#PlayPauseButton:pressed {
    background-color: #3d8b40;
}

/* Time Display */
QLabel#TimeDisplay {
    background-color: #1a1a1a;
    color: #4CAF50;
    border: 2px solid #333;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: bold;
}

/* BPM Spinbox */
QSpinBox {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 0px;
    font-size: 16px;
}

QSpinBox:focus {
    border-color: #555;
}

QSpinBox::up-button, QSpinBox::down-button {
    background-color: #1a1a1a;
    /*border: 1px solid #444;*/
    padding-right: 10px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #444;
}

QSpinBox::up-arrow {
    image: url('assets/icons/up-arrow.png');
    color: white;
}

QSpinBox::down-arrow {
    image: url('assets/icons/dropdown-arrow.png');
    color: white;
}

/* ComboBoxes */
QComboBox {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QComboBox:focus {
    border-color: #555;
}

QComboBox::drop-down {
    border: none;
    border-radius: 4px;
    background-color: #1a1a1a;
    padding-right: 10px;
}

QComboBox::down-arrow {
    image: url('assets/icons/dropdown-arrow.png');
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    selection-background-color: #4a5568;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border: none;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #4a5568;
    color: white;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3a4558;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #2b2b2b;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #555;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #555;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* DMX Side Panel Toggle (floating overlay on stage view) */
QPushButton#DmxPanelToggle {
    background-color: rgba(40, 40, 40, 200);
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 4px;
    font-weight: bold;
    padding: 0;
}

QPushButton#DmxPanelToggle:hover {
    background-color: rgba(70, 70, 70, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#DmxPanelToggle:pressed {
    background-color: rgba(20, 20, 20, 230);
}

/* Right Sidebar (Tabbed: Library + DMX Channels) */
QTabWidget#RightSidebar::pane {
    border: 1px solid #444;
    background-color: #2b2b2b;
    top: -1px;
}

QTabWidget#RightSidebar QTabBar {
    qproperty-drawBase: 0;
}

QTabWidget#RightSidebar QTabBar::tab {
    background-color: #2b2b2b;
    color: #aaa;
    padding: 6px 14px;
    border: 1px solid #444;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    font-size: 12px;
    font-weight: bold;
    min-width: 80px;
}

QTabWidget#RightSidebar QTabBar::tab:hover {
    background-color: #3a3a3a;
    color: #fff;
}

QTabWidget#RightSidebar QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #fff;
    border-color: #666;
}

QTabWidget#RightSidebar QTabBar::tab:!selected {
    margin-top: 2px;
}

/* Clip Library — Container */
QWidget#ClipLibrary {
    background-color: #2b2b2b;
}

/* Clip Library — QToolBox (one page per fixture) */
QToolBox#ClipLibraryToolBox {
    background-color: #2b2b2b;
    border: none;
}

QToolBox#ClipLibraryToolBox::tab {
    background-color: #383838;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 12px;
    font-weight: bold;
}

QToolBox#ClipLibraryToolBox::tab:hover {
    background-color: #4a4a4a;
    color: #fff;
    border-color: #666;
}

QToolBox#ClipLibraryToolBox::tab:selected {
    background-color: #4a5568;
    color: #fff;
    border-color: #5a6578;
}

/* Clip Library — Clip List & Scene List (per-fixture clips and LED scenes) */
QListWidget#ClipList,
QListWidget#SceneList {
    background-color: #1a1a1a;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 2px;
    font-size: 12px;
    outline: 0;
    show-decoration-selected: 1;
}

QListWidget#ClipList::item,
QListWidget#SceneList::item {
    padding: 6px 8px;
    border-radius: 3px;
    margin: 1px 0;
    color: #ddd;
}

QListWidget#ClipList::item:hover,
QListWidget#SceneList::item:hover {
    background-color: #3a4558;
    color: #fff;
}

QListWidget#ClipList::item:selected,
QListWidget#SceneList::item:selected {
    background-color: #4a5568;
    color: #fff;
}

QListWidget#ClipList::item:selected:!active,
QListWidget#SceneList::item:selected:!active {
    background-color: #4a5568;
    color: #fff;
}

/* General Widget Styling */
QWidget {
    color: white;
}

QLabel {
    color: white;
}