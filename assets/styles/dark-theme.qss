/* TupperDMX Simulator Dark Theme */

/* Tab bars — QMacStyle answers SH_TabBar_Alignment with AlignCenter, so every
   QTabWidget's tabs sit in the middle of the bar on macOS and hug the left
   everywhere else. The hint is read by QCommonStyle when it places the bar, and
   this rule is the only thing that overrides it. */
QTabWidget::tab-bar {
    alignment: left;
}

/* Main Splitter */
QSplitter {
    border: none;
    background-color: #2b2b2b;
}

QSplitter::handle {
    background-color: #444444;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* The fixture editors' list/editor divider. Wider than the 2px above because
   this one is meant to be found and dragged, not just to separate two docked
   regions — and transparent, since both panes already carry their own border.
   Scoped by object name so the window's own splitters keep the hairline. */
QSplitter#RatioSplitter::handle:horizontal {
    width: 11px;
    background-color: transparent;
}

QSplitter#RatioSplitter::handle:horizontal:hover {
    background-color: #4aa3df;
    margin: 0 4px;
    border-radius: 1px;
}

/* Timeline Widget */
#Timeline {
    border: none;
    background-color: #2b2b2b;
}

/* Graphics View (Stage) */
QGraphicsView {
    border: none;
    background-color: #2b2b2b;
}

/* Timeline Tooltip */
#TimelineTooltip {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}

/* Beat Detection Dialog */
QDialog {
    background-color: #2b2b2b;
    color: white;
}

QDialog QLabel {
    color: white;
}

QDialog QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #202020;
    border-top: 1px solid #5d5d5d;
    border-radius: 3px;
    padding: 8px 16px;
    font-size: 12px;
}

QDialog QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QDialog QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* File open Dialog */
QFileDialog QTreeView,
QFileDialog QListView,
QFileDialog QLineEdit {
    background-color: #2b2b2b;
    color: white;
}

/* Context Menus */
QMenu {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    padding: 2px;
}

QMenu::item {
    background-color: transparent;
    /* Item padding moves the LABEL only — the icon sits at the item's left
       edge — so QMenu::icon repeats the same 10px and the whole row (icon
       included) breathes away from the menu border. */
    padding: 8px 16px 8px 16px;
    border-radius: 3px;
}

QMenu::icon {
    left: 10px;
}

QMenu::item:selected {
    background-color: #3a5a67;
}

QMenu::item:disabled {
    color: #666;
}

QMenu::separator {
    height: 1px;
    background-color: #555;
    margin: 2px 0;
}

/* Mute Buttons */
#MetronomeMuteButton, #AudioMuteButton {
    color: #8a8a8a;
    border: none;
    border-radius: 2px;
    font-size: 10px;
}

#MetronomeMuteButton:checked, #AudioMuteButton:checked {
    background-color: red;
    color: white;
}

/* Toolbar tempo glyph (decorative ♩ next to the BPM spinbox) */
#MetronomeButton {
    background-color: transparent;
    color: #cfcfcf;
    font-size: 22px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

/* Combined track-header panel (TRACKS counter + MASTER/METRO volumes) */
#TrackHeaderPanel {
    background-color: #242424;
    border-right: 1px solid #444;
}

#TracksTitle {
    color: #d0d0d0;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 1px;
}

#TracksCount {
    color: #8a8a8a;
    font-size: 11px;
}

#VolumeRowLabel {
    color: #9a9a9a;
    font-size: 10px;
    font-weight: bold;
    min-width: 46px;
    max-width: 46px;
}

#VolumeDbLabel {
    color: #8a8a8a;
    font-size: 10px;
    min-width: 36px;
    max-width: 36px;
}

/* MASTER (audio) and METRO (metronome) volumes share a green→orange level
   gradient. The groove carries the full-width gradient; the unfilled (add-page)
   part is dimmed so it reads as a level meter. */
QSlider#MasterVolumeSlider::groove:horizontal,
QSlider#MetroVolumeSlider::groove:horizontal {
    height: 8px;
    border-radius: 3px;
    border: 1px solid #333;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3e8a3a, stop:0.7 #9bcf3a, stop:1 #e0a52e);
}

QSlider#MasterVolumeSlider::add-page:horizontal,
QSlider#MetroVolumeSlider::add-page:horizontal {
    background: rgba(18, 18, 18, 190);
    border-radius: 3px;
}

QSlider#MasterVolumeSlider::sub-page:horizontal,
QSlider#MetroVolumeSlider::sub-page:horizontal {
    background: transparent;
}

/* No visible knob — the gradient fill alone shows the level. The handle stays
   present (width > 0) so the groove is still click/drag-able. */
QSlider#MasterVolumeSlider::handle:horizontal,
QSlider#MetroVolumeSlider::handle:horizontal {
    background: transparent;
    border: none;
    width: 6px;
    margin: 0;
}

/* DMX Display Table */
QTableWidget {
    background-color: #2B2B2B;
    color: white;
    gridline-color: #444444;
    border: 1px solid #1f1f1f;
    alternate-background-color: #333333;
    selection-background-color: #3a5a67;
}

QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #3a5a67;
    color: white;
}

QHeaderView::section {
    background-color: #3A3A3A;
    color: white;
    padding: 4px 8px;
    border: 1px solid #444444;
    font-weight: bold;
}

QHeaderView::section:horizontal {
    border-left: none;
}

QHeaderView::section:vertical {
    border-top: none;
}

/* Toolbar */
QToolBar {
    background-color: #2b2b2b;
    border: none;
    spacing: 5px;
    padding: 5px;
}

/* Toolbar Sections */
QFrame#ToolbarSection {
    background-color: #363636;
    border: 1px solid #232323;
    border-radius: 3px;
    margin: 2px;
}

/* Section Titles */
QLabel#SectionTitle {
    background-color: #2b2b2b;
    border-radius: 6px;
    color: #aaa;
    font-size: 14px;
    font-weight: bold;
}

QLabel#SubsectionLabel {
    background-color: #3a3a3a;
    color: #aaa;
    font-size: 12px;
    font-weight: normal;
}

QLabel#SmallLabel {
    color: #aaa;
    font-size: 12px;
}

/* Load Buttons */
QPushButton#LoadButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #202020;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    padding: 8px;
    font-size: 12px;
}

QPushButton#LoadButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#LoadButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* Export split button (blue-accented primary; the ▾ segment opens the
   MIDI/bundle menu, the main area exports the bundle) */
QToolButton#ExportSplitButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3f78b5, stop:1 #34659c);
    color: #eaf4fb;
    border: 1px solid #274b73;
    border-top: 1px solid #6ba3d6;
    border-radius: 3px;
    /* right padding = 8px + the 21px ▾ segment, so the label centers in the
       main (clickable) area rather than the full button */
    padding: 0 29px 0 8px;
    font-size: 14px;
    font-weight: bold;
}

QToolButton#ExportSplitButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4685c4, stop:1 #3a70ab);
}

QToolButton#ExportSplitButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #34659c, stop:1 #2b5484);
}

QToolButton#ExportSplitButton::menu-button {
    border-left: 1px solid #274b73;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    width: 20px;
}

QToolButton#ExportSplitButton::menu-arrow {
    image: url('assets/icons/chevron-down.svg');
    width: 20px;
    height: 20px;
}

/* Playlist Navigation Buttons */
QPushButton#NavButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #202020;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#NavButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

QPushButton#NavButton:disabled {
    background: #333;
    color: #555;
    border-color: #444;
    border-top-color: #444;
}

/* Remove Song Button */
QPushButton#RemoveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #d98a8a;
    border: 1px solid #202020;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    font-size: 14px;
}

QPushButton#RemoveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
    color: #e89a9a;
}

QPushButton#RemoveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* Toolbar Hamburger Menu Button */
QToolButton#MenuButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #202020;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    padding: 0;
    font-weight: bold;
}

QToolButton#MenuButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QToolButton#MenuButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* Hide the default popup-indicator arrow — the ☰ glyph is enough. */
QToolButton#MenuButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

/* SHOW section: header, autosave state, show name and footer stats */
QLabel#ShowSectionTitle {
    background: transparent;
    color: #9a9a9a;
    font-size: 11px;
    font-weight: bold;
}

QLabel#AutosaveStatus {
    background: transparent;
    font-size: 11px;
}

QLabel#ShowNameLabel {
    background: transparent;
    color: #f0f0f0;
    font-size: 14px;
}

QLabel#ShowStatsLabel {
    background: transparent;
    color: #8a8a8a;
    font-size: 10px;
}

/* SETLIST section: unified song selector (counter badge + combobox) */
QFrame#SetlistSelector {
    background-color: #202020;
    border: 1px solid #161616;
    border-radius: 6px;
}

QLabel#SetlistCounter {
    background-color: #2d4a63;
    color: #cfe4f5;
    border-radius: 3px;
    padding: 0px 6px;
    margin: 6px 0px;
    font-size: 11px;
    font-family: ui-monospace,monospace;
}

QComboBox#SetlistCombo {
    background: transparent;
    border: none;
    color: #f0f0f0;
    font-size: 13px;
    font-weight: bold;
    padding: 2px 4px;
}

QComboBox#SetlistCombo QLineEdit {
    background: transparent;
    border: none;
    color: #f0f0f0;
    font-weight: bold;
}

QComboBox#SetlistCombo::drop-down {
    border: none;
    width: 18px;
}

QComboBox#SetlistCombo QAbstractItemView {
    background-color: #202020;
    border: 1px solid #161616;
    color: #e6e6e6;
    selection-background-color: #2d4a63;
    outline: none;
}

/* SETLIST footer: BPM / offset / linked chip */
QLabel#BpmLabel {
    background: transparent;
    color: #6fce7f;
    font-size: 11px;
    font-weight: bold;
}

QLabel#OffsetLabel {
    background: transparent;
    color: #8a8a8a;
    font-size: 11px;
}

QLabel#LinkedChip {
    background: transparent;
    font-size: 11px;
}

/* SONG FILES: one accent-coloured card per file (MIDI / BACKING TRACK /
   GUIDE) — header (icon + title + small actions) over a path well, or a
   dashed '+ Load …' call-to-action while the slot is empty. The accent
   rides the `kind` dynamic property. */
QFrame#FileCard {
    background-color: #202020;
    border: 1px solid #141414;
    border-radius: 6px;
}
QFrame#FileCard[kind="midi"]    { border-left: 3px solid #c9c356; }
QFrame#FileCard[kind="backing"] { border-left: 3px solid #6fce7f; }
QFrame#FileCard[kind="guide"]   { border-left: 3px solid #5da9e8; }

QLabel#FileCardIcon {
    background: transparent;
    font-size: 12px;
}

QLabel#FileCardTitle {
    background: transparent;
    font-size: 10px;
    font-weight: bold;
}
QLabel#FileCardTitle[kind="midi"]    { color: #c9c356; }
QLabel#FileCardTitle[kind="backing"] { color: #6fce7f; }
QLabel#FileCardTitle[kind="guide"]   { color: #5da9e8; }

QLabel#FileCardPath {
    background-color: #202020;
    color: #bdbdbd;
    font-size: 11px;
    font-family: ui-monospace,monospace;
}

QToolButton#FileCardButton {
    background: transparent;
    color: #b5b5b5;
    border: 1px solid #4a4a4a;
    border-radius: 3px;
    font-size: 11px;
}
QToolButton#FileCardButton:hover   { background-color: #3d3d3d; }
QToolButton#FileCardButton:pressed { background-color: #262626; }

QPushButton#FileCardAction {
    background: transparent;
    border: 1px dashed #4a4a4a;
    border-radius: 3px;
    font-size: 11px;
    padding: 2px 8px;
}
QPushButton#FileCardAction[kind="midi"]    { color: #c9c356; border-color: #5a5730; }
QPushButton#FileCardAction[kind="backing"] { color: #6fce7f; border-color: #3c6146; }
QPushButton#FileCardAction[kind="guide"]   { color: #5da9e8; border-color: #35567a; }
QPushButton#FileCardAction:hover   { background-color: #333; }
QPushButton#FileCardAction:pressed { background-color: #262626; }

/* Transport Buttons */
QPushButton#StopButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: white;
    border: 1px solid #202020;
    border-top: 1px solid #141414;
    border-radius: 5px;
    padding: 4px;
    min-width: 35px;
    max-width: 35px;
    min-height: 35px;
    max-height: 35px;
}

QPushButton#StopButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#StopButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

QPushButton#PlayPauseButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5ad36a, stop:1 #37ad48);
    color: white;
    border: 1px solid #2c7a36;
    border-radius: 5px;
    min-width: 35px;
    max-width: 35px;
    min-height: 35px;
    max-height: 35px;
}

QPushButton#PlayPauseButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #63dd73, stop:1 #3dbb50);
}

QPushButton#PlayPauseButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4bc35b, stop:1 #2f9a40);
}

/* Time Display */
QLabel#TimeDisplay {
    background-color: #1a1a1a;
    color: #46e05a;
    border: 2px solid #333;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: bold;
    min-width: 120px;
    max-width: 120px;
    min-height: 35px;
    max-height: 35px;
}

/* Line Edits */
QLineEdit {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 12px;
}

QLineEdit:focus {
    border-color: #555;
}

/* BPM Spinbox */
QSpinBox, QDoubleSpinBox {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 3px;
    padding: 4px 0px;
    font-size: 12px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #555;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #1a1a1a;
    /*border: 1px solid #444;*/
    padding-right: 10px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    /*background-color: #444;*/
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url('assets/icons/chevron-up.svg');
    width: 14px;
    height: 14px;
    color: white;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url('assets/icons/chevron-down.svg');
    width: 14px;
    height: 14px;
    color: white;
}

/* Checkboxes — dark bordered box, blue fill + white check when on */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #555;
    border-radius: 3px;
    background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
    border-color: #777;
}

QCheckBox::indicator:checked {
    background-color: #5e9ec2;
    border-color: #5e9ec2;
    image: url('assets/icons/checkmark.png');
}

QCheckBox::indicator:checked:hover {
    background-color: #79cdf0;
    border-color: #79cdf0;
}

QCheckBox::indicator:disabled {
    background-color: #222;
    border-color: #3a3a3a;
}

QCheckBox::indicator:checked:disabled {
    background-color: #3a5a67;
    border-color: #3a5a67;
}

/* Radio buttons — dark bordered circle, blue fill + white dot when on */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #555;
    border-radius: 9px;
    background-color: #1a1a1a;
}

QRadioButton::indicator:hover {
    border-color: #777;
}

QRadioButton::indicator:checked {
    image: url('assets/icons/radio-dot.png');
}

QRadioButton::indicator:checked:hover {
}

QRadioButton::indicator:disabled {
    background-color: #222;
    border-color: #3a3a3a;
}

QRadioButton::indicator:checked:disabled {
    border-color: #3a5a67;
}

/* ComboBoxes */
QComboBox {
    background-color: #262626;
    color: white;
    border: 1px solid #161616;
    border-radius: 3px;
    padding: 5px 10px;
    font-size: 12px;
}

QComboBox:hover {
    border-color: #555;
}

QComboBox:focus {
    border-color: #79cdf0;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
    width: 22px;
    padding-right: 6px;
}

QComboBox::down-arrow {
    image: url('assets/icons/chevron-down.svg');
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    selection-background-color: #3a5a67;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border: none;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3a5a67;
    color: white;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #4a6b78;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #2b2b2b;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #555;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #555;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* DMX Side Panel Toggle (floating overlay on stage view) */
QPushButton#DmxPanelToggle {
    background-color: rgba(40, 40, 40, 200);
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 3px;
    font-weight: bold;
    padding: 0;
}

QPushButton#DmxPanelToggle:hover {
    background-color: rgba(70, 70, 70, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#DmxPanelToggle:pressed {
    background-color: rgba(20, 20, 20, 230);
}

/* Right Sidebar (Tabbed: Library + DMX Channels) */
QTabWidget#RightSidebar::pane {
    border: 1px solid #1f1f1f;
    background-color: #2b2b2b;
    top: -1px;
}

QTabWidget#RightSidebar QTabBar {
    qproperty-drawBase: 0;
}

QTabWidget#RightSidebar QTabBar::tab {
    background-color: #2b2b2b;
    color: #aaa;
    padding: 6px 14px;
    border: 1px solid #1f1f1f;
    font-size: 12px;
    font-weight: normal;
    min-width: 80px;
}

QTabWidget#RightSidebar QTabBar::tab:hover {
    background-color: #3a3a3a;
    color: #fff;
}

QTabWidget#RightSidebar QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #fff;
    border-color: #666;
    font-weight: bold;
    border-bottom: 2px solid #79cdf0;
}

QTabWidget#RightSidebar QTabBar::tab:!selected {
    margin-top: 2px;
}

/* DMX Channels — segmented USED/FULL toggle + universe indicator */
QWidget#DmxDisplay {
    background-color: #2b2b2b;
}

QPushButton#DmxSeg {
    background-color: #3a3a3a;
    color: #cfcfcf;
    border: 1px solid #1f1f1f;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: normal;
}

QPushButton#DmxSeg[pos="left"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-right: none;
}

QPushButton#DmxSeg[pos="right"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton#DmxSeg:hover {
    background-color: #454545;
    color: #fff;
}

QPushButton#DmxSeg:checked {
    background-color: #e6e6e6;
    color: #1e1e1e;
    font-weight: bold;
}

QLabel#DmxUniverse {
    color: #cfcfcf;
    font-size: 11px;
    padding-right: 4px;
}

/* Clip Library — Container */
QWidget#ClipLibrary {
    background-color: #2b2b2b;
}

/* Clip Library — Search row */
QWidget#ClipSearchRow {
    background-color: transparent;
}

QLineEdit#ClipSearchBox {
    background-color: #1a1a1a;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 3px;
    padding: 5px 8px;
    font-size: 12px;
}

QLineEdit#ClipSearchBox:focus {
    border-color: #79cdf0;
}

QToolButton#ClipViewToggle {
    background-color: #1a1a1a;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 3px;
    padding: 4px 7px;
    font-size: 13px;
}

QToolButton#ClipViewToggle:hover {
    color: #fff;
    border-color: #666;
}

QToolButton#ClipViewToggle:checked {
    background-color: #3a3a3a;
    color: #cfe9f5;
    border-color: #666;
}

/* Clip Library — Group pills */
QWidget#ClipPillBar {
    background-color: transparent;
}

QFrame#ClipPill {
    background-color: #2e2e2e;
    border: 1px solid #1f1f1f;
    border-radius: 5px;
}

QFrame#ClipPill:hover {
    background-color: #4a4a4a;
    border-color: #1f1f1f;
}

QFrame#ClipPill[selected="true"] {
    background-color: #5e9ec2;
    border-color: #5e9ec2;
}

QLabel#ClipPillLabel {
    color: #ddd;
    font-size: 11px;
    font-weight: normal;
    background: transparent;
}

QFrame#ClipPill[selected="true"] QLabel#ClipPillLabel {
    color: #082230;
    font-weight: bold;
}

QLabel#ClipPillCount {
    color: #999;
    border-radius: 7px;
    /*padding: 0 4px;*/
    font-size: 9px;
    font-weight: normal;
}

QFrame#ClipPillNew {
    background-color: transparent;
    border: 1px solid #1f1f1f;
    border-radius: 12px;
}

/* It opens the fixture editor, so it has to answer the pointer like the pills
   beside it do. The dash brightens with the fill, or the outline washes out
   against the lighter ground it is drawn on. */
QFrame#ClipPillNew:hover {
    background-color: #3a3a3a;
    border-color: #8a8a8a;
}

QFrame#ClipPillNew:hover QLabel#ClipPillLabel {
    color: #dddddd;
}

QFrame#ClipPillNew QLabel#ClipPillLabel {
    color: #888;
    font-weight: normal;
}

/* Clip Library — Group header */
QWidget#ClipHeaderRow {
    background-color: transparent;
}

QLabel#ClipGroupHeader {
    color: #bbb;
    font-size: 12px;
    font-weight: bold;
    margin-top: 10px;
}

QLabel#ClipSortLabel {
    color: #888;
    font-size: 11px;
}

/* Clip Library — Clip cards */
QScrollArea#ClipCardScroll {
    background-color: transparent;
    border: none;
}

QWidget#ClipCardGrid {
    background-color: transparent;
}

QFrame#ClipCard {
    background-color: #262626;
    border: 1px solid #1c1c1c;
    border-radius: 5px;
}

QFrame#ClipCard:hover {
    background-color: #24323a;
    border-color: #4a7d92;
}

/* A favourite whose clip no longer resolves: its fixture was unpatched or its
   scene renamed. It stays on the Favorites page — dimmed, undraggable — until
   the operator unstars it. */
QFrame#ClipCard[available="false"] {
    background-color: #202020;
    border-style: dashed;
    border-color: #3a3a3a;
}

QFrame#ClipCard[available="false"]:hover {
    background-color: #202020;
    border-color: #4a4a4a;
}

QFrame#ClipCard[available="false"] QLabel#ClipCardTitle {
    color: #7d7d7d;
}

QLabel#ClipCardTitle {
    color: #eee;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#ClipCardType {
    color: #888;
    font-size: 10px;
    background: transparent;
}

QLabel#ClipLibraryPlaceholder {
    color: #888;
    font-size: 12px;
}

/* Scene Edit — Animation grid tiles */
/* One choice on a discrete channel — an effect, a preset, a wheel slot. */
QFrame#AnimationTile {
    background-color: #1a1a1a;
    border: 1px solid #444;
    border-radius: 3px;
}

QFrame#AnimationTile:hover {
    border-color: #888;
}

QFrame#AnimationTile[selected="true"] {
    border: 2px solid #79cdf0;
    background-color: #24414d;
}

/* START Event Edit Dialog */
QLabel#PaletteSectionHeader,
QLabel#PaletteModeHeader {
    font-weight: bold;
}

QLabel#PaletteModeHeader {
    margin-top: 8px;
}

QLabel#RandomHueLabel {
    color: #888;
    font-size: 10px;
}

QPushButton#RandomHueButton {
    background-color: #2a2a2a;
    color: #dddddd;
    border: 2px solid #555;
    border-radius: 3px;
    font-size: 22px;
    font-weight: bold;
}

QPushButton#RandomHueButton:checked {
    border: 3px solid white;
}

QPushButton#PaletteModeButton {
    padding: 8px;
    border: 2px solid #555;
    border-radius: 3px;
}

QPushButton#PaletteModeButton:checked {
    border: 3px solid white;
    background-color: #444;
}

/* Color swatch border/checked styling; the per-swatch fill is set in code. */
QPushButton#ColorSwatch {
    border: 2px solid #555;
    border-radius: 3px;
}

QPushButton#ColorSwatch:checked {
    border: 3px solid white;
}

/* Timeline track-header "A" (auto) toggle — green while following the
   song-part program, matching the play button's accent. */
QPushButton#AutoModeButton {
    background-color: #2a2a2a;
    color: #cccccc;
    border: 1px solid #555;
    border-radius: 3px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#AutoModeButton:hover {
    background-color: #3a3a3a;
    border-color: #777;
}

QPushButton#AutoModeButton:checked {
    background-color: #43c556;
    color: white;
    border: 1px solid #3ba84a;
}

QPushButton#AutoModeButton:checked:hover {
    background-color: #3bbf4d;
}

QPushButton#AutoModeButton:disabled {
    background-color: #222;
    color: #555;
    border-color: #333;
}

/* ---- Timeline track-header (TrackHeaderWidget) ---- */

/* Fixture name + MIDI/DMX address, stacked next to the swatch. */
QLabel#TrackName {
    color: #eaeaea;
    font-weight: bold;
    font-size: 16px;
}

QLabel#TrackInfo {
    color: #8a8a8a;
    font-size: 10px;
}

/* Reorder grip (placeholder) + collapse chevron — frameless; the chevron
   collapses the track and swaps its glyph rather than showing a checked fill. */
QPushButton#TrackGrip,
QPushButton#TrackChevron {
    background-color: transparent;
    border: none;
    color: #8a8a8a;
    font-size: 13px;
}

QPushButton#TrackChevron:hover {
    background-color: #3a3a3a;
    border-radius: 3px;
}

/* Eye (mute) + lock toggles — same frame as the "A" button; the UTF glyph is
   set as the button text (see TrackHeaderWidget). */
QPushButton#TrackEyeButton,
QPushButton#TrackLockButton {
    background-color: #2a2a2a;
    border: 1px solid #555;
    border-radius: 3px;
    font-size: 12px;
}

QPushButton#TrackEyeButton:hover,
QPushButton#TrackLockButton:hover {
    background-color: #3a3a3a;
    border-color: #777;
}

/* Muted: warm amber highlight. */
QPushButton#TrackEyeButton:checked {
    background-color: #6b4a1f;
    border: 1px solid #a5742c;
}

QPushButton#TrackEyeButton:checked:hover {
    background-color: #7c561f;
}

/* Locked: gold fill (the glyph also swaps to a closed padlock). */
QPushButton#TrackLockButton:checked {
    background-color: #c9a227;
    border: 1px solid #b08f1f;
}

QPushButton#TrackLockButton:checked:hover {
    background-color: #d4ac2c;
}

/* General Widget Styling */
QWidget {
    color: #dcdcdc;
    font-family: "Noto Sans", "Noto Color Emoji";
}

QLabel {
    color: #dcdcdc;
}

/* Stage scenario designer — "Edit stage" trigger + top-left edit toolbar.
   The dock/undock toggle sits beside it and shares the look: same corner,
   same control group. */
QPushButton#EditStageButton,
QPushButton#StageDockButton {
    background: rgba(26,28,32,.82);
    color: #cfe9f5;
    border: 1px solid #707070;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#EditStageButton:hover,
QPushButton#StageDockButton:hover {
    background-color: rgba(30, 30, 30, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#EditStageButton:pressed,
QPushButton#StageDockButton:pressed {
    background-color: rgba(20, 20, 20, 230);
}

/* Icon-only, so square rather than the text button's wide padding. */
QPushButton#StageDockButton {
    padding: 6px;
    min-width: 0;
}

QWidget#StageEditToolbar {
    background-color: rgba(28, 28, 28, 235);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 8px;
}

QLabel#EditModeLabel {
    color: white;
    font-weight: bold;
    padding: 0 4px;
}

/* The toolbar's OWN buttons only — `>`, not a descendant match, is load
   bearing. This toolbar parents the Add-fixture dialog (designer.py's
   `AddFixtureDialog(self._stage, self)`), and Qt walks the parent chain when it
   matches a descendant selector, so a dialog IS "inside" the widget that owns
   it. Written loosely, this rule paints every QPushButton in that dialog —
   and wins, because one ID plus two types outranks the `QPushButton#Name` the
   dialog styles its own buttons with. Its buttons all sit directly in this
   widget's layouts, so the child selector still reaches every one of them. */
QWidget#StageEditToolbar > QPushButton {
    color: white;
    background-color: #4a4a4a;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 3px;
    padding: 6px 12px;
    font-weight: bold;
}

QWidget#StageEditToolbar > QPushButton:hover {
    background-color: #5a5a5a;
}

QWidget#StageEditToolbar > QPushButton:disabled {
    color: #777;
    background-color: #3a3a3a;
    border-color: rgba(255, 255, 255, 20);
}

QWidget#StageEditToolbar QPushButton#EditToolbarAdd {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3c6e8a, stop:1 #2f5a72);
    border: 1px solid #1f4255;
    border-top: 1px solid #4d87a4;
    color: #eaf7fd;
}

QWidget#StageEditToolbar QPushButton#EditToolbarAdd:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #47809e, stop:1 #3a6d88);
}

QWidget#StageEditToolbar QPushButton#EditToolbarDone {
    background-color: #79cdf0;
    border-color: #5fb4d8;
    color: #082230;
}

QWidget#StageEditToolbar QPushButton#EditToolbarDone:hover {
    background-color: #8fd6f3;
}

/* The fog row. Every caption on it is a quiet label over a plain slider,
   except TEXTURE — which decides whether the stage reads as air or as a white
   filter laid over the picture, while the rest only tune air you already have.
   It leads the row, gets nearly twice the travel, and is coloured and sized to
   say so. */
QLabel#EditToolbarFogCaption {
    color: #8a8a8a;
    font-size: 10px;
}

QLabel#EditToolbarTextureCaption {
    color: #cfe6f3;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

QSlider#EditToolbarFogTexture::groove:horizontal {
    height: 6px;
    background-color: #2a2a2a;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 3px;
}

QSlider#EditToolbarFogTexture::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3c6e8a, stop:1 #79cdf0);
    border-radius: 3px;
}

QSlider#EditToolbarFogTexture::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    background-color: #cfe6f3;
    border: 1px solid #5fb4d8;
    border-radius: 6px;
}

QSlider#EditToolbarFogTexture::handle:horizontal:hover {
    background-color: #ffffff;
}

/* Fixture inspector — floating card for the selected fixture */
QWidget#FixtureInspector {
    background-color: rgba(28, 28, 28, 240);
    border: 1px solid rgba(255, 255, 255, 45);
    border-radius: 8px;
}

QLabel#InspectorTitle {
    color: white;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#InspectorClose {
    background-color: transparent;
    color: #aaa;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#InspectorClose:hover {
    color: white;
}

QLabel#InspectorSection {
    color: #8a8a8a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-top: 6px;
}

QLabel#InspectorFieldLabel {
    color: #bbb;
    font-size: 11px;
}

/* The two ends of a switch. Both are always readable — the one in force is
   what the fixture IS, so it is the one that lights up. */
QLabel#InspectorSideLabel {
    color: #777;
    font-size: 11px;
}

QLabel#InspectorSideLabel[active="true"] {
    color: white;
    font-weight: bold;
}

QLabel#InspectorHint {
    color: #8a8a8a;
    font-size: 10px;
}

QLabel#InspectorReadonly {
    color: white;
    background-color: #333;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 3px;
    padding: 5px 8px;
}

QWidget#FixtureInspector QLineEdit,
QWidget#FixtureInspector QSpinBox {
    color: white;
    background-color: #3a3a3a;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 3px;
    padding: 5px 8px;
}

QWidget#FixtureInspector QLineEdit:focus,
QWidget#FixtureInspector QSpinBox:focus {
    border-color: #79cdf0;
}

QPushButton#InspectorDelete {
    color: #ff8a8a;
    background-color: rgba(120, 40, 40, 200);
    border: 1px solid #a04040;
    border-radius: 3px;
    padding: 7px 12px;
    font-weight: bold;
}

QPushButton#InspectorDelete:hover {
    background-color: rgba(150, 50, 50, 220);
    color: white;
}

QPushButton#InspectorDelete:pressed {
    background-color: rgba(100, 30, 30, 230);
}

/* ============================================================
   Timeline toolbar (strip above the timeline tracks)
   Transport widgets reuse #StopButton/#PlayPauseButton/
   #TimeDisplay/#MetronomeButton styles defined above.
   ============================================================ */
QWidget#TimelineToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #303030, stop:1 #2a2a2a);
    border-top: 2px solid #181818;
    border-bottom: 1px solid #181818;
}

QFrame#TTSeparator {
    color: rgba(255, 255, 255, 30);
    max-width: 1px;
    margin: 4px 4px;
}

/* The view controls (Rows / zoom / Fit) once a narrow window folds them out
   of the toolbar row and into their own popup. */
QFrame#TTViewPopup {
    background: #303030;
    border: 1px solid #181818;
    border-radius: 4px;
}

QLabel#TTRowsLabel,
QLabel#TTCountInLabel {
    color: #aaa;
    padding: 0 2px;
}

/* Generic tool buttons + Add track */
QWidget#TimelineToolbar QPushButton#TTToolButton,
QWidget#TimelineToolbar QPushButton#TTAddTrack,
QWidget#TimelineToolbar QPushButton#TTFit {
    color: #e0e0e0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3d3d3d, stop:1 #333);
    border: 1px solid #1d1d1d;
    border-top: 1px solid #454545;
    border-radius: 3px;
    padding: 5px 10px;
}

QWidget#TimelineToolbar QPushButton#TTToolButton:hover,
QWidget#TimelineToolbar QPushButton#TTAddTrack:hover,
QWidget#TimelineToolbar QPushButton#TTFit:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #464646, stop:1 #3c3c3c);
}

QWidget#TimelineToolbar QPushButton#TTAddTrack {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3c6e8a, stop:1 #2f5a72);
    border: 1px solid #1f4255;
    border-top: 1px solid #4d87a4;
    color: #eaf7fd;
    font-weight: bold;
}

QWidget#TimelineToolbar QPushButton#TTAddTrack:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #47809e, stop:1 #3a6d88);
}

/* Snap toggle */
QWidget#TimelineToolbar QPushButton#TTSnap {
    color: #e0e0e0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3d3d3d, stop:1 #333);
    border: 1px solid #1d1d1d;
    border-top: 1px solid #454545;
    border-radius: 3px;
    padding: 5px 10px;
}

QWidget#TimelineToolbar QPushButton#TTSnap:checked {
    color: white;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3f78b5, stop:1 #34659c);
    border: 1px solid #274b73;
    font-weight: bold;
}

/* The segmented switch (ui/widgets/segmented.py): Bars|Time, Rows S/M/L,
   BACKING|GUIDE, and the fixture dialog's chase DIRECTION and TIMING UNITS.
   Deliberately NOT scoped to #TimelineToolbar — it is the app's switch, not
   that toolbar's, and a second copy of these rules under another name is how
   two controls doing the same job start looking different. */
QPushButton#TTSegment {
    color: #9a9a9a;
    /* Every one of these is stated on purpose, including the ones that look
       like defaults. This switch is used inside dialogs, and `QDialog
       QPushButton` up at the top of this file gives every button in one a
       raised gradient, a lighter top edge, a 3px radius and its own font size
       — none of which a segment wants, and all of which reach anything left
       unsaid here. The radius is the visible one: unset, each segment rounds
       its INNER corners too and the pill comes apart at the seam. */
    background: #242424;
    border: 1px solid #161616;
    border-top: 1px solid #161616;
    border-radius: 0;
    font-size: 12px;
    /* A line of 12px text, so an icon-only segment stands as tall as a worded
       one. Two switches side by side (chase DIRECTION and TIMING UNITS) are
       one row, and 6px of difference between them reads as a mistake. */
    min-height: 17px;
    padding: 4px 8px;
}

QPushButton#TTSegment:hover {
    color: #d0d0d0;
}

QPushButton#TTSegment:checked {
    color: #e6e6e6;
    background: #3a3a3a;
    font-weight: bold;
}

QPushButton#TTSegment:disabled {
    color: #4a4a4a;
}

/* Round only the outer corners of the segmented control */
QPushButton#TTSegment[seg="left"] {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    border-right: 0px;
}

/* One narrow width for every segment: single letters (Rows S/M/L) and
   icon-only segments, neither of which has text to size to. */
QPushButton#TTSegment[compact="true"] {
    min-width: 28px;
    max-width: 28px;
}

QPushButton#TTSegment[seg="right"] {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left: 0px;
}

/* Zoom slider */
QSlider#TTZoom {
    min-width: 120px;
    max-width: 120px;
}

QSlider#TTZoom::groove:horizontal {
    background: #1a1a1a;
    height: 6px;
    border: 1px solid #444;
    border-radius: 3px;
}

QSlider#TTZoom::handle:horizontal {
    background: #d0d0d0;
    border: 1px solid #222;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider#TTZoom::handle:horizontal:hover {
    background: #ffffff;
}

/* ============================================================
   Settings dialog — Input / Output page
   Numbered routing cards, quick-mode strip, signal-flow panel.
   Graph colours are painted in code (ui/io_flow_widget.py).
   ============================================================ */
QLabel#SettingsSectionTitle {
    color: #e0e0e0;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#SettingsHintLabel {
    color: #8a8a8a;
    font-size: 11px;
}

QFrame#SettingsCard, QFrame#SignalFlowPanel {
    background-color: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 10px;
}

/* Circled number badge — filled blue disc (radius = half the 22px set in code) */
QLabel#SettingsCardBadge {
    background-color: #79cdf0;
    color: #082230;
    border-radius: 11px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#SettingsCardTitle {
    background: transparent;
    color: #e0e0e0;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#SettingsCardSubtitle, QLabel#SettingsDimLabel {
    background: transparent;
    color: #8a8a8a;
    font-size: 11px;
}

/* The number a settings slider is currently on, e.g. the UI scale's "100%". */
QLabel#SettingsValueLabel {
    background: transparent;
    color: #e0e0e0;
    font-family: 'Courier New', monospace;
    font-size: 12px;
}

/* Names written under a slider's ticks: dim, except the stop the handle is on. */
QLabel#SliderTickLabel {
    background: transparent;
    color: #6f6f6f;
    font-size: 11px;
}

QLabel#SliderTickLabel[active="true"] {
    color: #e0e0e0;
}

QLabel#SettingsToggleLabel {
    background: transparent;
    color: #cfcfcf;
    font-size: 11px;
}

/* Controller-card body dims while its power toggle is off. */
QFrame#SettingsCard QLabel:disabled,
QFrame#SettingsCard QCheckBox:disabled,
QFrame#SettingsCard QRadioButton:disabled {
    color: #5f5f5f;
}

/* Live validation strip under the flow graph. */
QLabel#IOValidationLabel {
    background: transparent;
    font-size: 11px;
}

QLabel#IOValidationLabel[state="ok"] {
    color: #4CAF50;
}

QLabel#IOValidationLabel[state="warn"] {
    color: #d9a13b;
}

QLabel#IOValidationLabel[state="error"] {
    color: #e05252;
}

/* ============================================================
   Settings dialog — sidebar navigation + per-page chrome
   Left rail with the page list and the version footer; each
   page opens with a heading row over a 1px hairline.
   ============================================================ */
QFrame#SettingsSidebar {
    background-color: #1f1f1f;
    border-right: 1px solid #3a3a3a;
}

QListWidget#SettingsSidebarList {
    background: transparent;
    border: none;
    outline: none;
    font-size: 12px;
}

QListWidget#SettingsSidebarList::item {
    color: #cfcfcf;
    padding: 8px 10px;
    border-radius: 6px;
    margin-bottom: 2px;
}

QListWidget#SettingsSidebarList::item:hover {
    background-color: #2e2e2e;
}

QListWidget#SettingsSidebarList::item:selected {
    background-color: #79cdf0;
    color: #082230;
}

QLabel#SettingsVersionLabel {
    color: #6a6a6a;
    font-size: 10px;
    padding-left: 4px;
}

QFrame#SettingsHairline {
    background-color: #3a3a3a;
    border: none;
}

/* Web-remote URL readout next to the port spinbox. */
QLabel#SettingsLinkLabel {
    color: #79cdf0;
    font-family: monospace;
    font-size: 12px;
}

/* ------------------------------------------------------------
   Settings dialog — Logging page
   A path field that carries its own icon and size readout, over
   the live `tail -f` pane (ui/widgets/log_tail.py). Line colours
   inside the pane are painted per line, in code.
   ------------------------------------------------------------ */

/* Reads as one line edit; it is a frame so the folder icon and the
   "38.4 MB · 12 files" readout can sit inside the same box. */
QFrame#SettingsPathField {
    background-color: #1a1a1a;
    border: 1px solid #444;
    border-radius: 3px;
}

QFrame#SettingsPathField QLineEdit#SettingsPathEdit {
    background: transparent;
    border: none;
    padding: 4px 0px;
}

QToolButton#SettingsPathIcon {
    background: transparent;
    border: none;
    padding: 2px;
}

QLabel#LogTailStatus {
    color: #8a8a8a;
    font-size: 11px;
}

QPlainTextEdit#LogTailPane {
    background-color: #161616;
    color: #d6d6d6;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    padding: 4px 6px;
    font-family: "JetBrains Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
    min-height: 150px;
}

/* ============================================================
   About dialog (ui/about_dialog.py)
   Hero (icon + title + version pill) over a BUILD metadata
   card and a © / Changelog / Website footer.
   ============================================================ */
QDialog#AboutDialog {
    background-color: #262626;
}

QWidget#aboutHero {
    background-color: #262626;
}

QWidget#aboutBuild {
    background-color: #1f1f1f;
    border-top: 1px solid #333333;
    border-bottom: 1px solid #333333;
}

QWidget#aboutFooter {
    background-color: #262626;
}

QLabel#aboutTitle {
    color: #f2f2f2;
    font-size: 24px;
    font-weight: bold;
}

QLabel#aboutTagline {
    color: #9a9a9a;
    font-size: 13px;
}

QLabel#aboutPill {
    border: 1px solid #3d3d3d;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    background-color: #202020;
}

QLabel#aboutSectionHeader {
    color: #767676;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
}

QLabel#aboutRowLabel {
    color: #8f8f8f;
    font-size: 12px;
}

QLabel#aboutRowValue {
    color: #dcdcdc;
    font-size: 12px;
    font-family: "JetBrains Mono", "Menlo", "Consolas", monospace;
}

QPushButton#aboutCopy {
    background-color: #333333;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 2px 10px;
    color: #d0d0d0;
    font-size: 11px;
}

QPushButton#aboutCopy:hover {
    background-color: #3d3d3d;
}

QPushButton#aboutCopy:pressed {
    background-color: #202020;
}

QLabel#aboutCopyright {
    color: #7a7a7a;
    font-size: 12px;
}

QPushButton#aboutLink {
    background: transparent;
    border: none;
    color: #9a9a9a;
    font-size: 12px;
    padding: 6px 10px;
}

QPushButton#aboutLink:hover {
    color: #e0e0e0;
}

QPushButton#aboutWebsite {
    background-color: #333333;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 6px 14px;
    color: #e6e6e6;
    font-size: 12px;
}

QPushButton#aboutWebsite:hover {
    background-color: #3d3d3d;
}

QPushButton#aboutWebsite:pressed {
    background-color: #202020;
}

/* ============================================================
   Add fixture dialog (ui/add_fixture_dialog.py)
   Library rail (search + grouping + tree) | detail panel
   (header, General/Channels/Modes tabs) over the patch footer.
   Capability chips are coloured in code — the palette depends
   on the fixture — as is the patch occupancy bar.
   ============================================================ */
QDialog#AddFixtureDialog {
    background-color: #262626;
}

/* --- library rail --- */
QFrame#AddFxLibrary {
    background-color: #1f1f1f;
    border-right: 1px solid #3a3a3a;
}

QFrame#AddFxSearchBox {
    background-color: #2b2b2b;
    border: 1px solid #45484b;
    border-radius: 3px;
    min-height: 28px;
}

QLabel#AddFxSearchGlyph {
    color: #7a7a7a;
    font-size: 14px;
}

QLineEdit#AddFxSearchInput {
    background: transparent;
    border: none;
    color: #e0e0e0;
    font-size: 12px;
    padding: 0;
}

QLabel#AddFxSearchCount {
    color: #7a7a7a;
    font-size: 11px;
}

QFrame#AddFxSegment {
    background-color: #2b2b2b;
    border-radius: 3px;
    border: 1px solid #45484b;
    padding: 2px;
}

QPushButton#AddFxSegmentButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    color: #9a9a9a;
    font-size: 12px;
    font-weight: normal !important;
    padding: 5px 10px;
}

QPushButton#AddFxSegmentButton:hover {
    color: #d0d0d0;
}

QPushButton#AddFxSegmentButton:checked {
    background-color: #34383b;
    color: #f0f0f0;
    font-weight: bold;
}

/* The library tree. Only the rows are styled here: the second column — a
   group's count badge and a fixture's dimmed caption — is painted by
   `_TreeAsideDelegate` in ui/add_fixture_dialog.py, because QSS reaches a
   tree's items but not one column of them. */
QTreeWidget#AddFxTree {
    background: transparent;
    border: none;
    outline: none;
    font-size: 12px;
}

QTreeWidget#AddFxTree::item {
    color: #c8c8c8;
    padding: 4px 2px;
}

QTreeWidget#AddFxTree::item:has-children {
    color: #e8e8e8;
    font-weight: bold;
}

QTreeWidget#AddFxTree::item:hover {
    background-color: #2e2e2e;
}

QTreeWidget#AddFxTree::item:selected {
    background-color: #3a6ea5;
    color: #ffffff;
}

/* --- detail panel --- */
QFrame#AddFxDetail {
    background-color: #262626;
}

QLabel#AddFxDetailManufacturer {
    color: #8a8a8a;
    font-size: 11px;
    letter-spacing: 1px;
}

QLabel#AddFxDetailName {
    color: #f0f0f0;
    font-size: 21px;
}

/* The model, once the title above it is carrying a name of the operator's
   own. Set beside the manufacturer and styled with it, so the pair reads as
   one line of provenance rather than as a second title. */
QLabel#AddFxDetailModel {
    color: #6f6f6f;
    font-size: 11px;
    letter-spacing: 1px;
}

/* Rename: a pencil that only shows its edges under the pointer, so it sits
   beside the title without competing with it. */
QToolButton#AddFxRename {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px;
}

QToolButton#AddFxRename:hover {
    background-color: #3a3a3a;
    border-color: #4f4f4f;
}

QLabel#AddFxStatLabel {
    color: #7a7a7a;
    font-size: 10px;
    letter-spacing: 1px;
}

QLabel#AddFxStatValue {
    color: #e6e6e6;
    font-size: 17px;
}

QLabel#AddFxChip {
    border-radius: 3px;
    font-size: 10px;
    padding: 2px 7px;
}

QTabWidget#AddFxTabs::pane {
    background-color: #232323;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    top: -1px;
}

QTabWidget#AddFxTabs QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #9a9a9a;
    font-size: 12px;
    margin-right: 4px;
    padding: 7px 14px;
}

QTabWidget#AddFxTabs QTabBar::tab:hover {
    color: #d8d8d8;
}

QTabWidget#AddFxTabs QTabBar::tab:selected {
    border-bottom: 2px solid #79cdf0;
    color: #ffffff;
}

QScrollArea#AddFxScroll {
    background: transparent;
    border: none;
}

QScrollArea#AddFxScroll > QWidget > QWidget {
    background: transparent;
}

QFrame#AddFxCard {
    background-color: #2a2a2a;
    border: 1px solid #383838;
    border-radius: 3px;
}

QLabel#AddFxCardTitle {
    border-bottom: 1px solid #383838;
    border-top-left-radius: 5px;
    border-top-right-radius: 0px;
    color: #9a9a9a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 6px 14px;
}

QLabel#AddFxRowLabel {
    color: #8f8f8f;
    font-size: 11px;
}

QLabel#AddFxRowValue {
    color: #e0e0e0;
    font-family: monospace;
    font-size: 12px;
}

QLabel#AddFxComment {
    color: #c0c0c0;
    font-size: 12px;
}

QPushButton#AddFxLinkButton {
    background-color: #303030;
    border: 1px solid #3f3f3f;
    border-radius: 3px;
    color: #cfcfcf;
    font-size: 11px;
    padding: 5px 10px;
    text-align: left;
}

QPushButton#AddFxLinkButton:hover {
    background-color: #3a3a3a;
    color: #ffffff;
}

QLabel#AddFxHint {
    color: #9a9a9a;
    font-size: 11px;
    border-bottom: 1px solid #383838;
}

/* --- channels table --- */
QTreeWidget#AddFxChannels {
    background-color: #232323;
    border: 1px solid #333333;
    border-radius: 3px;
    font-size: 12px;
    outline: none;
}

QTreeWidget#AddFxChannels::item {
    color: #d8d8d8;
    padding: 5px 4px;
}

QTreeWidget#AddFxChannels::item:selected {
    background-color: #2f2f2f;
    color: #ffffff;
}

QTreeWidget#AddFxChannels QHeaderView::section {
    background-color: #232323;
    border: none;
    border-bottom: 1px solid #3a3a3a;
    color: #7a7a7a;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 6px 4px;
}

/* --- modes --- */
QFrame#AddFxModeCard {
    background-color: #2a2a2a;
    border: 1px solid #383838;
    border-radius: 3px;
}

QFrame#AddFxModeCard[selected="true"] {
    background-color: #2c3947;
    border: 1px solid #4a7fa8;
}

QLabel#AddFxModeName {
    color: #f0f0f0;
    font-size: 13px;
    font-weight: bold;
}

/* --- scenes --- */
QFrame#AddFxScenesPanel {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 3px;
}

QToolButton#AddFxNewScene {
    background-color: #2c2c2c;
    border: 1px solid #3f3f3f;
    border-radius: 3px;
    color: #cfcfcf;
    font-size: 11px;
    padding: 3px 8px;
}

QToolButton#AddFxNewScene:hover {
    background-color: #353535;
    color: #ffffff;
}

QToolButton#AddFxNewScene::menu-indicator {
    image: none;
    width: 0px;
}

QTreeWidget#AddFxScenes {
    background-color: #191919;
    border: 1px solid #303030;
    border-radius: 3px;
    font-size: 12px;
    outline: none;
}

QTreeWidget#AddFxScenes::item {
    color: #d8d8d8;
    padding: 4px 3px;
}

QTreeWidget#AddFxScenes::item:has-children {
    color: #9a9a9a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
}

QTreeWidget#AddFxScenes::item:hover {
    background-color: #262626;
}

QTreeWidget#AddFxScenes::item:selected {
    background-color: #2c5f8a;
    color: #ffffff;
}

QPushButton#AddFxSceneAction,
QToolButton#AddFxSceneAction {
    background-color: #2c2c2c;
    border: 1px solid #3f3f3f;
    border-radius: 3px;
    color: #cfcfcf;
    font-size: 11px;
    padding: 5px 6px;
}

QPushButton#AddFxSceneAction:hover,
QToolButton#AddFxSceneAction:hover {
    background-color: #353535;
    color: #ffffff;
}

QPushButton#AddFxSceneAction:disabled,
QToolButton#AddFxSceneAction:disabled {
    color: #5a5a5a;
}

/* The menu indicator is already in the label text ("… ▾"), so suppress Qt's. */
QToolButton#AddFxSceneAction::menu-indicator {
    image: none;
    width: 0;
}

QLineEdit#AddFxSceneName {
    background-color: #191919;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    color: #f0f0f0;
    font-size: 13px;
    padding: 6px 8px;
}

QLineEdit#AddFxSceneName:focus {
    border: 1px solid #4a90e2;
}

QPushButton#AddFxSceneSave {
    background-color: #2c5f8a;
    border: 1px solid #4a90e2;
    border-radius: 3px;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    min-width: 62px;
    padding: 7px 14px;
}

QPushButton#AddFxSceneSave:hover {
    background-color: #35719f;
}

QPushButton#AddFxSceneSave:disabled {
    background-color: #242424;
    border: 1px solid #333333;
    color: #5a5a5a;
}

/* The quiet half of the save pair: the same box as #AddFxSceneSave, so the two
   line up in the name row, in the palette of #AddFxSceneAction, because it is
   the secondary of the two — it makes a new scene out of the changes instead
   of writing them over the one being shown. */
QPushButton#AddFxSceneSaveAs {
    background-color: #2c2c2c;
    border: 1px solid #3f3f3f;
    border-radius: 3px;
    color: #cfcfcf;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 7px 12px;
}

QPushButton#AddFxSceneSaveAs:hover {
    background-color: #353535;
    color: #ffffff;
}

QPushButton#AddFxSceneSaveAs:disabled {
    background-color: #242424;
    border: 1px solid #333333;
    color: #5a5a5a;
}

/* Song-part tags. Outlined, not filled, so they read as tags rather than as
   another row of buttons — they are `_PartChip` labels, and the checked state
   arrives as a property. Nothing here may set a width: they are sized by their
   own text so the nine of them fit one row (ui/fixture_scenes_tab.py). */
QLabel#AddFxSongPart {
    background: transparent;
    border: 1px solid #343434;
    border-radius: 7px;
    color: #7a7a7a;
    font-size: 8px;
    letter-spacing: 1px;
    padding: 3px 5px;
}

QLabel#AddFxSongPart:hover {
    border: 1px solid #4f4f4f;
    color: #b8b8b8;
}

QLabel#AddFxSongPart[checked="true"] {
    background-color: #24405a;
    border: 1px solid #4a90e2;
    color: #bfe0fb;
}

QLabel#AddFxSongPart[checked="true"]:hover {
    background-color: #2c4a63;
    color: #ddf0ff;
}

QLabel#AddFxSongPart:disabled {
    border: 1px solid #2a2a2a;
    color: #454545;
}

/* The Scenes tab's SIMULATED OUTPUT card: one dark surface carrying the
   read-out, the caption and the preview. The preview has no panel of its own —
   it repaints this same gradient (ScenePreview._BACKDROP_TOP/_BOTTOM, which
   must follow any change here). */
QFrame#AddFxOutputCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a1a1a, stop:1 #0e0e0e);
    border: 1px solid #303030;
    border-radius: 3px;
}

QGraphicsView#AddFxPreview {
    background: transparent;
    border: none;
}

QLabel#AddFxSceneSummary {
    font-family: monospace;
    font-size: 11px;
}

QLabel#AddFxFaderValue {
    color: #d8d8d8;
    font-family: monospace;
    font-size: 11px;
}

QLabel#AddFxFaderAddress {
    color: #6f6f6f;
    font-family: monospace;
    font-size: 10px;
}

QLabel#AddFxFaderName {
    color: #8a8a8a;
    font-size: 9px;
}

/* A channel the scene being edited does not carry. It is still live — moving
   the fader is what adds it — so this dims rather than disables. */
QLabel#AddFxFaderName[absent="true"] {
    color: #5a5a5a;
    font-style: italic;
}

/* A channel whose capabilities name discrete choices: its name opens a picker,
   so it has to read as a control rather than as a caption. */
QLabel#AddFxFaderName[pickable="true"] {
    color: #a8c8d8;
    text-decoration: underline;
}

QLabel#AddFxFaderName[pickable="true"]:hover {
    color: #79cdf0;
}

QSlider#AddFxFader::groove:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #191919, stop:1 #131313);
    border: 1px solid #333333;
    border-radius: 0px;
    width: 12px;
}

QSlider#AddFxFader::add-page:vertical {
    border-radius: 0px;
    margin: 1px;
}

QSlider#AddFxFader::sub-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #242424, stop:1 #1c1c1c);
    border-radius: 0px;
    margin: 1px;
}

QSlider#AddFxFader::handle:vertical {
    border-radius: 1px;
    height: 3px;
    margin: 0px -3px;
}

QSlider#AddFxFader:disabled::add-page:vertical {
    background: #2a2a2a;
}

/* --- chases ---
   The list panel, the "+ New" button and the Save button are the Scenes tab's
   (#AddFxScenesPanel, #AddFxNewScene, #AddFxSceneSave), so the two tabs read as
   one editor. Only what the Scenes tab has no equivalent of is styled here. */
QFrame#AddFxSceneHeader,
QFrame#AddFxChaseHeader,
QFrame#AddFxStepsCard {
    background-color: #202020;
    border: 1px solid #303030;
    border-radius: 3px;
}

QPushButton#AddFxChaseRun {
    background-color: #2c5f8a;
    border: 1px solid #4a90e2;
    border-radius: 3px;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    min-width: 56px;
    padding: 5px 12px;
}

QPushButton#AddFxChaseRun:hover {
    background-color: #35719f;
}

QPushButton#AddFxChaseRun:checked {
    background-color: #8a3c2c;
    border: 1px solid #e2704a;
}

QPushButton#AddFxChaseRun:disabled {
    background-color: #242424;
    border: 1px solid #333333;
    color: #5a5a5a;
}

QLabel#AddFxChaseStep {
    color: #f0f0f0;
    font-family: monospace;
    font-size: 12px;
    font-weight: bold;
}

/* The step table. The header caption is #AddFxFieldLabel like every other
   caption in the dialog; these are the cells under it. */
QWidget#AddFxStepHeader {
    border-bottom: 1px solid #303030;
    padding-bottom: 4px;
}

QWidget#AddFxStepRow {
    background: transparent;
}

QLabel#AddFxStepNumber {
    color: #6f6f6f;
    font-family: monospace;
    font-size: 11px;
}

QComboBox#AddFxStepScene {
    background-color: #191919;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    color: #d8d8d8;
    font-size: 11px;
    padding: 4px 6px;
}

QComboBox#AddFxStepScene:hover {
    border: 1px solid #4f4f4f;
}

QComboBox#AddFxStepScene::drop-down {
    border: none;
    width: 16px;
}

QComboBox#AddFxStepScene QAbstractItemView {
    background-color: #1c1c1c;
    border: 1px solid #3a3a3a;
    color: #d8d8d8;
    selection-background-color: #2c5f8a;
}

/* One box holding the number and the unit it is counted in, so the unit stays
   at the right-hand edge instead of trailing the digits around. */
QFrame#AddFxStepTime {
    background-color: #191919;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    min-height: 24px;
}

QFrame#AddFxStepTime:hover {
    border: 1px solid #4f4f4f;
}

QDoubleSpinBox#AddFxStepTimeSpin {
    background: transparent;
    border: none;
    color: #d8d8d8;
    font-family: monospace;
    font-size: 11px;
}

QLabel#AddFxStepUnit {
    color: #6f6f6f;
    font-family: monospace;
    font-size: 10px;
}

QLabel#AddFxStepLevelValue {
    color: #d8d8d8;
    font-family: monospace;
    font-size: 11px;
}

QSlider#AddFxStepLevel::groove:horizontal {
    background-color: #262626;
    border-radius: 2px;
    height: 4px;
}

QSlider#AddFxStepLevel::sub-page:horizontal {
    background-color: #4a90e2;
    border-radius: 2px;
}

QSlider#AddFxStepLevel::handle:horizontal {
    background-color: #cfcfcf;
    border-radius: 2px;
    height: 10px;
    margin: -4px 0;
    width: 4px;
}

QToolButton#AddFxStepButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #7a7a7a;
    font-size: 10px;
    padding: 2px;
}

QToolButton#AddFxStepButton:hover {
    background-color: #2c2c2c;
    border: 1px solid #3f3f3f;
    color: #ffffff;
}

QToolButton#AddFxAddStep {
    background: transparent;
    border: 1px dashed #3a3a3a;
    border-radius: 3px;
    color: #8a8a8a;
    font-size: 11px;
    padding: 4px 10px;
}

QToolButton#AddFxAddStep:hover {
    border: 1px dashed #4a90e2;
    color: #ffffff;
}

QToolButton#AddFxAddStep:disabled {
    border: 1px dashed #2a2a2a;
    color: #454545;
}

QScrollArea#AddFxStepScroll,
QScrollArea#AddFxStepScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

/* --- footer --- */
QFrame#AddFxFooter {
    background-color: #1f1f1f;
    border-top: 1px solid #3a3a3a;
}

QLabel#AddFxFieldLabel {
    color: #7a7a7a;
    font-size: 10px;
    letter-spacing: 1px;
}

QLabel#AddFxOccupies {
    color: #c8c8c8;
    font-family: monospace;
    font-size: 12px;
}

QLabel#AddFxStatus {
    font-size: 10px;
}

QLabel#AddFxStatus[state="ok"] {
    color: #6fce7f;
}

QLabel#AddFxStatus[state="error"] {
    color: #e05252;
}

QDialog#AddFixtureDialog QSpinBox#AddFxDmxSpin,
QDialog#AddFixtureDialog QSpinBox#AddFxChannelSpin {
    background-color: #1a1a1a;
    border: 1px solid #3f3f3f;
    border-radius: 3px;
    color: #ffffff;
    font-size: 18px;
    padding: 4px 8px;
}

QDialog#AddFixtureDialog QSpinBox#AddFxDmxSpin:focus,
QDialog#AddFixtureDialog QSpinBox#AddFxChannelSpin:focus {
    border-color: #79cdf0;
}

QDialog#AddFixtureDialog QPushButton#AddFxChannelButton {
    background-color: #2b2b2b;
    border: 1px solid #3a3a3a;
    border-radius: 3px;
    color: #9a9a9a;
    font-size: 10px;
    padding: 0;
}

QDialog#AddFixtureDialog QPushButton#AddFxChannelButton:hover {
    background-color: #383838;
    color: #e0e0e0;
}

/* A channel already driving a patched fixture — pickable, but flagged. */
QDialog#AddFixtureDialog QPushButton#AddFxChannelButton[used="true"] {
    background-color: #3a2a2a;
    border-color: #5a3a3a;
    color: #b07070;
}

QDialog#AddFixtureDialog QPushButton#AddFxChannelButton:checked {
    background-color: #3a6ea5;
    border-color: #79cdf0;
    color: #ffffff;
    font-weight: bold;
}

QDialog#AddFixtureDialog QPushButton#AddFxOk {
    background-color: #79cdf0;
    border: 1px solid #5fb4d8;
    border-radius: 3px;
    color: #082230;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 22px;
}

QDialog#AddFixtureDialog QPushButton#AddFxOk:hover {
    background-color: #8fd6f3;
}

QDialog#AddFixtureDialog QPushButton#AddFxOk:disabled {
    background-color: #3a4a52;
    border-color: #35424a;
    color: #6a7a82;
}

/* Edit mode only: the instance's own name, up in the header beside the type,
   and Delete down in the footer. Both share the dialog's existing family —
   the name field matches the footer's spin boxes, Delete the inspector's. */
QDialog#AddFixtureDialog QLineEdit#AddFxNameEdit {
    background-color: #1a1a1a;
    border: 1px solid #4f4f4f;
    border-radius: 3px;
    color: #ffffff;
    font-size: 21px;
    padding: 1px 8px;
}

QDialog#AddFixtureDialog QLineEdit#AddFxNameEdit:focus {
    border-color: #79cdf0;
}

QDialog#AddFixtureDialog QPushButton#AddFxDelete {
    background-color: rgba(120, 40, 40, 200);
    border: 1px solid #a04040;
    border-radius: 5px;
    color: #ff8a8a;
    font-size: 12px;
    font-weight: bold;
    padding: 7px 18px;
}

QDialog#AddFixtureDialog QPushButton#AddFxDelete:hover {
    background-color: rgba(150, 50, 50, 220);
    color: #ffffff;
}

QDialog#AddFixtureDialog QPushButton#AddFxCancel {
    background-color: #2f2f2f;
    border: 1px solid #3f3f3f;
    border-radius: 5px;
    color: #cfcfcf;
    font-size: 12px;
    padding: 7px 22px;
}

QDialog#AddFixtureDialog QPushButton#AddFxCancel:hover {
    background-color: #3a3a3a;
    color: #ffffff;
}

/* ── Clip edit dialog ───────────────────────────────────────────────────────
   Reuses the AddFx* card/fader/chip family (those selectors are unscoped);
   only the pieces with no counterpart there are named here. */

QDialog#ClipEdit {
    background-color: #262626;
}

QDialog#ClipEdit QComboBox#ClipEditVerb {
    background-color: #1f1f1f;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    color: #e0e0e0;
    font-size: 12px;
    padding: 6px 10px;
}

QDialog#ClipEdit QComboBox#ClipEditVerb:focus {
    border-color: #79cdf0;
}

QDialog#ClipEdit QComboBox#ClipEditVerb::drop-down {
    border: none;
    width: 22px;
}

/* Group headers in the verb picker are set NoItemFlags, so Qt draws them
   disabled — this makes them read as section titles rather than dead rows. */
QDialog#ClipEdit QComboBox#ClipEditVerb QAbstractItemView::item:disabled {
    color: #7a7a7a;
    font-size: 10px;
    letter-spacing: 1px;
    padding-top: 6px;
}

QLabel#AddFxStatus[state="error"] {
    color: #e05252;
}

QLabel#AddFxStatus[state="info"] {
    color: #7a7a7a;
}

/* The discrete-channel picker, floating over the fader that opened it. */
QWidget#ClipEditPopover {
    background-color: #262626;
    border: 1px solid #45484b;
    border-radius: 6px;
}

/* ===================================================================
   Sizes that live here so the UI scale can reach them
   ===================================================================
   These were setFixedWidth/setFixedSize calls in Python, which the scale
   rewrite in ui/theme.py cannot see — so at 125% their labels were clipped by
   boxes that had stayed at 100%. `min == max` is how a stylesheet spells
   setFixedSize(); widgets whose look is already defined above carry their
   sizes there instead of being repeated here. */

/* The song's musical key (TONO) — three characters like "Am" or "F#m". */
QLineEdit#SongKeyEdit {
    min-width: 44px;
    max-width: 44px;
}

/* Transport BPM. */
QWidget#TimelineToolbar QSpinBox#TTBpm {
    min-width: 50px;
    max-width: 50px;
    min-height: 30px;
    max-height: 30px;
}


/* ============================================================
   MARKERS DIALOG (ui/markers_dialog.py)
   The per-song marker track: voice cues, tempo changes, stop-click
   and the segue. Sizes live here rather than in Python so
   ui/theme.py's ui_scale rewrite reaches them.
   ============================================================ */
QDialog#MarkersDialog {
    background-color: #1e1e1e;
    min-width: 720px;
    min-height: 520px;
}

QLabel#MarkersSongTitle {
    color: #e0e0e0;
    font-size: 14px;
    font-weight: bold;
}

/* The mini timeline. Its marker size is derived from this height in code,
   so scaling the height scales the markers with it. */
QWidget#MarkerStrip {
    min-height: 46px;
    max-height: 46px;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
}

QTableWidget#MarkersTable {
    background-color: #232323;
    alternate-background-color: #262626;
    gridline-color: #333333;
    border: 1px solid #3a3a3a;
    border-radius: 6px;
    min-width: 340px;
}

QTableWidget#MarkersTable::item {
    padding: 5px 6px;
}

QFrame#MarkersInspector {
    background-color: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    min-width: 210px;
    max-width: 260px;
}

QLabel#MarkersInspectorTitle {
    background: transparent;
    color: #e0e0e0;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    padding-bottom: 2px;
}

QFrame#MarkersSegueBar {
    background-color: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 2px;
}

QToolButton#MarkersAddButton {
    background-color: #3a3a3a;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 5px 10px;
}

QToolButton#MarkersAddButton:hover {
    background-color: #454545;
}

QToolButton#MarkersAddButton::menu-button {
    border-left: 1px solid #4a4a4a;
    width: 16px;
}

/* Time / Bar.beat segmented toggle — square inner edges so the pair reads
   as one control (same treatment as the timeline toolbar's Bars/Time). */
QPushButton#MarkersUnitButton {
    background-color: #2f2f2f;
    color: #b0b0b0;
    border: 1px solid #4a4a4a;
    padding: 4px 10px;
    min-width: 58px;
}

QPushButton#MarkersUnitButton:checked {
    background-color: #3a5a67;
    color: #ffffff;
}

QSpinBox#MarkersBpmSpin, QDoubleSpinBox#MarkersTimeSpin,
QDoubleSpinBox#MarkersSegueSpin, QLineEdit#MarkersTextEdit {
    background-color: #2b2b2b;
    color: #e0e0e0;
    border: 1px solid #4a4a4a;
    border-radius: 4px;
    padding: 4px 6px;
    min-height: 18px;
}

QDoubleSpinBox#MarkersSegueSpin {
    min-width: 90px;
}

QSpinBox#MarkersBpmSpin:focus, QDoubleSpinBox#MarkersTimeSpin:focus,
QDoubleSpinBox#MarkersSegueSpin:focus, QLineEdit#MarkersTextEdit:focus {
    border: 1px solid #79cdf0;
}
