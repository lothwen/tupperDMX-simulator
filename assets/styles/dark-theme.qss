/* TupperDMX Simulator Dark Theme */

/* Main Splitter */
QSplitter {
    border: none;
    background-color: #2b2b2b;
}

QSplitter::handle {
    background-color: #444444;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Timeline Widget */
#Timeline {
    border: none;
    background-color: #2b2b2b;
}

/* Graphics View (Stage) */
QGraphicsView {
    border: none;
    background-color: #2b2b2b;
}

/* Timeline Tooltip */
#TimelineTooltip {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* Beat Detection Dialog */
QDialog {
    background-color: #2b2b2b;
    color: white;
}

QDialog QLabel {
    color: white;
}

QDialog QPushButton {
    background-color: #555;
    color: white;
    border: 1px solid #666;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 12px;
}

QDialog QPushButton:hover {
    background-color: #666;
}

QDialog QPushButton:pressed {
    background-color: #444;
}

/* File open Dialog */
QFileDialog QTreeView,
QFileDialog QListView,
QFileDialog QLineEdit {
    background-color: #2b2b2b;
    color: white;
}

/* Context Menus */
QMenu {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    padding: 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 8px 16px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #4a5568;
}

QMenu::item:disabled {
    color: #666;
}

QMenu::separator {
    height: 1px;
    background-color: #555;
    margin: 2px 0;
}

/* Mute Buttons */
#MetronomeMuteButton, #AudioMuteButton {
    color: #8a8a8a;
    border: none;
    border-radius: 2px;
    font-size: 10px;
}

#MetronomeMuteButton:checked, #AudioMuteButton:checked {
    background-color: red;
    color: white;
}

/* Toolbar tempo glyph (decorative ♩ next to the BPM spinbox) */
#MetronomeButton {
    background-color: transparent;
    color: #cfcfcf;
    font-size: 22px;
}

/* Combined track-header panel (TRACKS counter + MASTER/METRO volumes) */
#TrackHeaderPanel {
    background-color: #2f2f2f;
}

#TracksTitle {
    color: #d0d0d0;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 1px;
}

#TracksCount {
    color: #8a8a8a;
    font-size: 11px;
}

#VolumeRowLabel {
    color: #9a9a9a;
    font-size: 10px;
    font-weight: bold;
}

#VolumeDbLabel {
    color: #8a8a8a;
    font-size: 10px;
}

/* MASTER (audio) and METRO (metronome) volumes share a green→orange level
   gradient. The groove carries the full-width gradient; the unfilled (add-page)
   part is dimmed so it reads as a level meter. */
QSlider#MasterVolumeSlider::groove:horizontal,
QSlider#MetroVolumeSlider::groove:horizontal {
    height: 8px;
    border-radius: 4px;
    border: 1px solid #333;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #43d65a, stop:0.55 #cdd23f, stop:1 #ef8b2b);
}

QSlider#MasterVolumeSlider::add-page:horizontal,
QSlider#MetroVolumeSlider::add-page:horizontal {
    background: rgba(18, 18, 18, 190);
    border-radius: 4px;
}

QSlider#MasterVolumeSlider::sub-page:horizontal,
QSlider#MetroVolumeSlider::sub-page:horizontal {
    background: transparent;
}

/* No visible knob — the gradient fill alone shows the level. The handle stays
   present (width > 0) so the groove is still click/drag-able. */
QSlider#MasterVolumeSlider::handle:horizontal,
QSlider#MetroVolumeSlider::handle:horizontal {
    background: transparent;
    border: none;
    width: 6px;
    margin: 0;
}

/* DMX Display Table */
QTableWidget {
    background-color: #2B2B2B;
    color: white;
    gridline-color: #444444;
    border: 1px solid #444444;
    alternate-background-color: #333333;
    selection-background-color: #4A5568;
}

QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #4A5568;
    color: white;
}

QHeaderView::section {
    background-color: #3A3A3A;
    color: white;
    padding: 4px 8px;
    border: 1px solid #444444;
    font-weight: bold;
}

QHeaderView::section:horizontal {
    border-left: none;
}

QHeaderView::section:vertical {
    border-top: none;
}

/* Toolbar */
QToolBar {
    background-color: #2b2b2b;
    border: none;
    spacing: 5px;
    padding: 5px;
}

/* Toolbar Sections */
QFrame#ToolbarSection {
    background-color: #3a3a3a;
    border: 1px solid #555;
    border-radius: 8px;
    margin: 2px;
}

/* Section Titles */
QLabel#SectionTitle {
    background-color: #2b2b2b;
    border-radius: 6px;
    color: #aaa;
    font-size: 14px;
    font-weight: bold;
}

QLabel#SubsectionLabel {
    background-color: #3a3a3a;
    color: #aaa;
    font-size: 12px;
    font-weight: normal;
}

QLabel#SmallLabel {
    color: #aaa;
    font-size: 12px;
}

/* Load Buttons */
QPushButton#LoadButton {
    background-color: #555;
    color: white;
    border: 1px solid #666;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#LoadButton:hover {
    background-color: #666;
}

QPushButton#LoadButton:pressed {
    background-color: #444;
}

/* New Button */
QPushButton#NewButton {
    background-color: #2d5016;
    color: white;
    border: 1px solid #3d6026;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#NewButton:hover {
    background-color: #3d6026;
}
QPushButton#NewButton:pressed {
    background-color: #1d4006;
}

/* Export Button */
QPushButton#ExportButton {
    background-color: #4a5568;
    color: white;
    border: 1px solid #5a6578;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#ExportButton:hover {
    background-color: #5a6578;
}

QPushButton#ExportButton:pressed {
    background-color: #3a4558;
}

QPushButton#ExportButton:disabled {
    background-color: #333;
    color: #666;
    border-color: #444;
}

/* Playlist Navigation Buttons */
QPushButton#NavButton {
    background-color: #4a5568;
    color: white;
    border: 1px solid #5a6578;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background-color: #5a6578;
}

QPushButton#NavButton:pressed {
    background-color: #3a4558;
}

QPushButton#NavButton:disabled {
    background-color: #333;
    color: #555;
    border-color: #444;
}

/* Remove Song Button */
QPushButton#RemoveButton {
    background-color: #6b3030;
    color: white;
    border: 1px solid #7b4040;
    border-radius: 6px;
    font-size: 14px;
}

QPushButton#RemoveButton:hover {
    background-color: #8b4040;
}

QPushButton#RemoveButton:pressed {
    background-color: #5b2020;
}

/* Toolbar Hamburger Menu Button */
QToolButton#MenuButton {
    background-color: #4a5568;
    color: white;
    border: 1px solid #5a6578;
    border-radius: 6px;
    padding: 0;
    font-weight: bold;
}

QToolButton#MenuButton:hover {
    background-color: #5a6578;
    border-color: #6a7588;
}

QToolButton#MenuButton:pressed {
    background-color: #3a4558;
}

/* Hide the default popup-indicator arrow — the ☰ glyph is enough. */
QToolButton#MenuButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

/* Song Counter Label */
QLabel#SongCounter {
    background-color: #1a1a1a;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
}

/* File Labels */
QLabel#FileLabel {
    background-color: #2b2b2b;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 2px 12px;
    font-size: 11px;
}

/* Transport Buttons */
QPushButton#StopButton {
    background-color: #555;
    color: white;
    border: 1px solid #666;
    border-radius: 5px;
    padding: 4px;
}

QPushButton#StopButton:hover {
    background-color: #666;
}

QPushButton#StopButton:pressed {
    background-color: #444;
}

QPushButton#PlayPauseButton {
    background-color: #4CAF50;
    color: white;
    border: 2px solid #45a049;
    border-radius: 5px;
}

QPushButton#PlayPauseButton:hover {
    background-color: #45a049;
}

QPushButton#PlayPauseButton:pressed {
    background-color: #3d8b40;
}

/* Time Display */
QLabel#TimeDisplay {
    background-color: #1a1a1a;
    color: #4CAF50;
    border: 2px solid #333;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: bold;
}

/* Line Edits */
QLineEdit {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QLineEdit:focus {
    border-color: #555;
}

/* BPM Spinbox */
QSpinBox, QDoubleSpinBox {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 0px;
    font-size: 16px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #555;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #1a1a1a;
    /*border: 1px solid #444;*/
    padding-right: 10px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #444;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url('assets/icons/up-arrow.png');
    color: white;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url('assets/icons/dropdown-arrow.png');
    color: white;
}

/* ComboBoxes */
QComboBox {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QComboBox:focus {
    border-color: #555;
}

QComboBox::drop-down {
    border: none;
    border-radius: 4px;
    background-color: #1a1a1a;
    padding-right: 10px;
}

QComboBox::down-arrow {
    image: url('assets/icons/dropdown-arrow.png');
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    selection-background-color: #4a5568;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border: none;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #4a5568;
    color: white;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3a4558;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #2b2b2b;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #555;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #555;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* DMX Side Panel Toggle (floating overlay on stage view) */
QPushButton#DmxPanelToggle {
    background-color: rgba(40, 40, 40, 200);
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 4px;
    font-weight: bold;
    padding: 0;
}

QPushButton#DmxPanelToggle:hover {
    background-color: rgba(70, 70, 70, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#DmxPanelToggle:pressed {
    background-color: rgba(20, 20, 20, 230);
}

/* Right Sidebar (Tabbed: Library + DMX Channels) */
QTabWidget#RightSidebar::pane {
    border: 1px solid #1f1f1f;
    background-color: #2b2b2b;
    top: -1px;
}

QTabWidget#RightSidebar QTabBar {
    qproperty-drawBase: 0;
}

QTabWidget#RightSidebar QTabBar::tab {
    background-color: #2b2b2b;
    color: #aaa;
    padding: 6px 14px;
    border: 1px solid #1f1f1f;
    font-size: 12px;
    font-weight: normal;
    min-width: 80px;
}

QTabWidget#RightSidebar QTabBar::tab:hover {
    background-color: #3a3a3a;
    color: #fff;
}

QTabWidget#RightSidebar QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #fff;
    border-color: #666;
    font-weight: bold;
    border-bottom: 2px solid #79cdf0;
}

QTabWidget#RightSidebar QTabBar::tab:!selected {
    margin-top: 2px;
}

/* Clip Library — Container */
QWidget#ClipLibrary {
    background-color: #2b2b2b;
}

/* Clip Library — Search row */
QWidget#ClipSearchRow {
    background-color: transparent;
}

QLineEdit#ClipSearchBox {
    background-color: #1a1a1a;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
}

QLineEdit#ClipSearchBox:focus {
    border-color: #5a6578;
}

QToolButton#ClipViewToggle {
    background-color: #1a1a1a;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 7px;
    font-size: 13px;
}

QToolButton#ClipViewToggle:hover {
    color: #fff;
    border-color: #666;
}

QToolButton#ClipViewToggle:checked {
    background-color: #4a5568;
    color: #fff;
    border-color: #5a6578;
}

/* Clip Library — Group pills */
QWidget#ClipPillBar {
    background-color: transparent;
}

QFrame#ClipPill {
    background-color: #383838;
    border: 1px solid #444;
    border-radius: 6px;
}

QFrame#ClipPill:hover {
    background-color: #4a4a4a;
    border-color: #666;
}

QFrame#ClipPill[selected="true"] {
    background-color: #5e9ec2;
    border-color: #5a6578;
}

QLabel#ClipPillLabel {
    color: #ddd;
    font-size: 11px;
    font-weight: normal;
    background: transparent;
}

QFrame#ClipPill[selected="true"] QLabel#ClipPillLabel {
    color: #082230;
    font-weight: bold;
}

QLabel#ClipPillCount {
    color: #999;
    border-radius: 7px;
    /*padding: 0 4px;*/
    font-size: 9px;
    font-weight: normal;
}

QFrame#ClipPillNew {
    background-color: transparent;
    border: 1px dashed #666;
    border-radius: 12px;
}

QFrame#ClipPillNew QLabel#ClipPillLabel {
    color: #888;
    font-weight: normal;
}

/* Clip Library — Group header */
QWidget#ClipHeaderRow {
    background-color: transparent;
}

QLabel#ClipGroupHeader {
    color: #bbb;
    font-size: 12px;
    font-weight: bold;
    margin-top: 10px;
}

QLabel#ClipSortLabel {
    color: #888;
    font-size: 11px;
}

/* Clip Library — Clip cards */
QScrollArea#ClipCardScroll {
    background-color: transparent;
    border: none;
}

QWidget#ClipCardGrid {
    background-color: transparent;
}

QFrame#ClipCard {
    background-color: #262626;
    border: 1px solid #1c1c1c;
    border-radius: 5px;
}

QFrame#ClipCard:hover {
    background-color: #2a3038;
    border-color: #5a6578;
}

QLabel#ClipCardTitle {
    color: #eee;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#ClipCardType {
    color: #888;
    font-size: 10px;
    background: transparent;
}

QLabel#ClipLibraryPlaceholder {
    color: #888;
    font-size: 12px;
}

/* Scene Edit — Animation grid tiles */
QFrame#AnimationTile {
    background-color: #1a1a1a;
    border: 1px solid #444;
    border-radius: 4px;
}

QFrame#AnimationTile:hover {
    border-color: #888;
}

QFrame#AnimationTile[selected="true"] {
    border: 2px solid #4a90e2;
    background-color: #2a3a55;
}

/* Scene Edit — Brightness slider (black → white gradient groove) */
QSlider#BrightnessSlider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #000000, stop:1 #ffffff);
    height: 10px;
    border: 1px solid #555;
    border-radius: 5px;
}

QSlider#BrightnessSlider::handle:horizontal {
    background: #d0d0d0;
    border: 1px solid #222;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider#BrightnessSlider::handle:horizontal:hover {
    background: #ffffff;
}

/* START Event Edit Dialog */
QLabel#PaletteSectionHeader,
QLabel#PaletteModeHeader {
    font-weight: bold;
}

QLabel#PaletteModeHeader {
    margin-top: 8px;
}

QLabel#RandomHueLabel {
    color: #888;
    font-size: 10px;
}

QPushButton#RandomHueButton {
    background-color: #2a2a2a;
    color: #dddddd;
    border: 2px solid #555;
    border-radius: 4px;
    font-size: 22px;
    font-weight: bold;
}

QPushButton#RandomHueButton:checked {
    border: 3px solid white;
}

QPushButton#PaletteModeButton {
    padding: 8px;
    border: 2px solid #555;
    border-radius: 4px;
}

QPushButton#PaletteModeButton:checked {
    border: 3px solid white;
    background-color: #444;
}

/* Color swatch border/checked styling; the per-swatch fill is set in code. */
QPushButton#ColorSwatch {
    border: 2px solid #555;
    border-radius: 4px;
}

QPushButton#ColorSwatch:checked {
    border: 3px solid white;
}

/* Timeline track-header "A" (auto) toggle — green while following the
   song-part program, matching the play button's accent. */
QPushButton#AutoModeButton {
    background-color: #2a2a2a;
    color: #cccccc;
    border: 1px solid #555;
    border-radius: 3px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#AutoModeButton:hover {
    background-color: #3a3a3a;
    border-color: #777;
}

QPushButton#AutoModeButton:checked {
    background-color: #4CAF50;
    color: white;
    border: 1px solid #45a049;
}

QPushButton#AutoModeButton:checked:hover {
    background-color: #45a049;
}

QPushButton#AutoModeButton:disabled {
    background-color: #222;
    color: #555;
    border-color: #333;
}

/* ---- Timeline track-header (TrackHeaderWidget) ---- */

/* Fixture name + MIDI/DMX address, stacked next to the swatch. */
QLabel#TrackName {
    color: #eaeaea;
    font-weight: bold;
    font-size: 16px;
}

QLabel#TrackInfo {
    color: #8a8a8a;
    font-size: 10px;
}

/* Reorder grip + collapse chevron — placeholders, so no frame/hover. */
QPushButton#TrackGrip,
QPushButton#TrackChevron {
    background-color: transparent;
    border: none;
    color: #8a8a8a;
    font-size: 13px;
}

QPushButton#TrackChevron:hover {
    background-color: #3a3a3a;
    border-radius: 3px;
}

/* Eye (mute) + lock toggles — same frame as the "A" button; the UTF glyph is
   set as the button text (see TrackHeaderWidget). */
QPushButton#TrackEyeButton,
QPushButton#TrackLockButton {
    background-color: #2a2a2a;
    border: 1px solid #555;
    border-radius: 3px;
    font-size: 12px;
}

QPushButton#TrackEyeButton:hover,
QPushButton#TrackLockButton:hover {
    background-color: #3a3a3a;
    border-color: #777;
}

/* Muted: warm amber highlight. */
QPushButton#TrackEyeButton:checked {
    background-color: #6b4a1f;
    border: 1px solid #a5742c;
}

QPushButton#TrackEyeButton:checked:hover {
    background-color: #7c561f;
}

/* Locked: gold fill (the glyph also swaps to a closed padlock). */
QPushButton#TrackLockButton:checked {
    background-color: #c9a227;
    border: 1px solid #b08f1f;
}

QPushButton#TrackLockButton:checked:hover {
    background-color: #d4ac2c;
}

/* General Widget Styling */
QWidget {
    color: white;
    font-family: "Helvetica Neue";
}

QLabel {
    color: white;
}

/* Stage scenario designer — "Edit stage" trigger + top-left edit toolbar */
QPushButton#EditStageButton {
    background-color: rgba(40, 40, 40, 200);
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton#EditStageButton:hover {
    background-color: rgba(70, 70, 70, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#EditStageButton:pressed {
    background-color: rgba(20, 20, 20, 230);
}

QWidget#StageEditToolbar {
    background-color: rgba(28, 28, 28, 235);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 8px;
}

QLabel#EditModeLabel {
    color: white;
    font-weight: bold;
    padding: 0 4px;
}

QWidget#StageEditToolbar QPushButton {
    color: white;
    background-color: #4a4a4a;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 5px;
    padding: 6px 12px;
    font-weight: bold;
}

QWidget#StageEditToolbar QPushButton:hover {
    background-color: #5a5a5a;
}

QWidget#StageEditToolbar QPushButton:disabled {
    color: #777;
    background-color: #3a3a3a;
    border-color: rgba(255, 255, 255, 20);
}

QWidget#StageEditToolbar QPushButton#EditToolbarAdd {
    background-color: #2f6db0;
    border-color: #3f7dc0;
}

QWidget#StageEditToolbar QPushButton#EditToolbarAdd:hover {
    background-color: #3f7dc0;
}

QWidget#StageEditToolbar QPushButton#EditToolbarDone {
    background-color: #3a86d6;
    border-color: #4a96e6;
}

QWidget#StageEditToolbar QPushButton#EditToolbarDone:hover {
    background-color: #4a96e6;
}

/* Fixture inspector — floating card for the selected fixture */
QWidget#FixtureInspector {
    background-color: rgba(28, 28, 28, 240);
    border: 1px solid rgba(255, 255, 255, 45);
    border-radius: 8px;
}

QLabel#InspectorTitle {
    color: white;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#InspectorClose {
    background-color: transparent;
    color: #aaa;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#InspectorClose:hover {
    color: white;
}

QLabel#InspectorSection {
    color: #8a8a8a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-top: 6px;
}

QLabel#InspectorFieldLabel {
    color: #bbb;
    font-size: 11px;
}

QLabel#InspectorReadonly {
    color: white;
    background-color: #333;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 4px;
    padding: 5px 8px;
}

QWidget#FixtureInspector QLineEdit,
QWidget#FixtureInspector QSpinBox {
    color: white;
    background-color: #3a3a3a;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 4px;
    padding: 5px 8px;
}

QWidget#FixtureInspector QLineEdit:focus,
QWidget#FixtureInspector QSpinBox:focus {
    border-color: #4a96e6;
}

QPushButton#InspectorDelete {
    color: #ff8a8a;
    background-color: rgba(120, 40, 40, 200);
    border: 1px solid #a04040;
    border-radius: 5px;
    padding: 7px 12px;
    font-weight: bold;
}

QPushButton#InspectorDelete:hover {
    background-color: rgba(150, 50, 50, 220);
    color: white;
}

QPushButton#InspectorDelete:pressed {
    background-color: rgba(100, 30, 30, 230);
}

/* ============================================================
   Timeline toolbar (strip above the timeline tracks)
   Transport widgets reuse #StopButton/#PlayPauseButton/
   #TimeDisplay/#MetronomeButton styles defined above.
   ============================================================ */
QWidget#TimelineToolbar {
    background-color: #2b2b2b;
    border-top: 2px solid #181818;
    border-bottom: 1px solid #181818;
}

QFrame#TTSeparator {
    color: rgba(255, 255, 255, 30);
    max-width: 1px;
    margin: 4px 4px;
}

QLabel#TTRowsLabel {
    color: #aaa;
    padding: 0 2px;
}

/* Generic tool buttons + Add track */
QWidget#TimelineToolbar QPushButton#TTToolButton,
QWidget#TimelineToolbar QPushButton#TTAddTrack,
QWidget#TimelineToolbar QPushButton#TTFit {
    color: #e0e0e0;
    background-color: #3a3a3a;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 5px;
    padding: 5px 10px;
}

QWidget#TimelineToolbar QPushButton#TTToolButton:hover,
QWidget#TimelineToolbar QPushButton#TTAddTrack:hover,
QWidget#TimelineToolbar QPushButton#TTFit:hover {
    background-color: #4a4a4a;
}

QWidget#TimelineToolbar QPushButton#TTAddTrack {
    background-color: #2f6db0;
    border-color: #3f7dc0;
    font-weight: bold;
}

QWidget#TimelineToolbar QPushButton#TTAddTrack:hover {
    background-color: #3f7dc0;
}

/* Snap toggle */
QWidget#TimelineToolbar QPushButton#TTSnap {
    color: #e0e0e0;
    background-color: #3a3a3a;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 5px;
    padding: 5px 10px;
}

QWidget#TimelineToolbar QPushButton#TTSnap:checked {
    color: white;
    background-color: #4CAF50;
    border-color: #45a049;
    font-weight: bold;
}

/* Segmented toggles (Bars|Time, Rows S/M/L) */
QWidget#TimelineToolbar QPushButton#TTSegment {
    color: #cfcfcf;
    background-color: #333;
    border: 1px solid #444;
    padding: 5px 2px;
}

QWidget#TimelineToolbar QPushButton#TTSegment:checked {
    color: white;
    background-color: #4a4a4a;
    border-color: #5a5a5a;
    font-weight: bold;
}

/* Round only the outer corners of the segmented control */
QWidget#TimelineToolbar QPushButton#TTSegment[seg="left"] {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

QWidget#TimelineToolbar QPushButton#TTSegment[seg="right"] {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

/* Zoom slider */
QSlider#TTZoom::groove:horizontal {
    background: #1a1a1a;
    height: 6px;
    border: 1px solid #444;
    border-radius: 3px;
}

QSlider#TTZoom::handle:horizontal {
    background: #d0d0d0;
    border: 1px solid #222;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider#TTZoom::handle:horizontal:hover {
    background: #ffffff;
}