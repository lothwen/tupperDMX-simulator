/* TupperDMX Simulator Dark Theme */

/* Main Splitter */
QSplitter {
    border: none;
    background-color: #2b2b2b;
}

QSplitter::handle {
    background-color: #444444;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* Timeline Widget */
#Timeline {
    border: none;
    background-color: #2b2b2b;
}

/* Graphics View (Stage) */
QGraphicsView {
    border: none;
    background-color: #2b2b2b;
}

/* Timeline Tooltip */
#TimelineTooltip {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* Beat Detection Dialog */
QDialog {
    background-color: #2b2b2b;
    color: white;
}

QDialog QLabel {
    color: white;
}

QDialog QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 12px;
}

QDialog QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QDialog QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* File open Dialog */
QFileDialog QTreeView,
QFileDialog QListView,
QFileDialog QLineEdit {
    background-color: #2b2b2b;
    color: white;
}

/* Context Menus */
QMenu {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    padding: 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 8px 16px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #3a5a67;
}

QMenu::item:disabled {
    color: #666;
}

QMenu::separator {
    height: 1px;
    background-color: #555;
    margin: 2px 0;
}

/* Mute Buttons */
#MetronomeMuteButton, #AudioMuteButton {
    color: #8a8a8a;
    border: none;
    border-radius: 2px;
    font-size: 10px;
}

#MetronomeMuteButton:checked, #AudioMuteButton:checked {
    background-color: red;
    color: white;
}

/* Toolbar tempo glyph (decorative ♩ next to the BPM spinbox) */
#MetronomeButton {
    background-color: transparent;
    color: #cfcfcf;
    font-size: 22px;
}

/* Combined track-header panel (TRACKS counter + MASTER/METRO volumes) */
#TrackHeaderPanel {
    background-color: #242424;
    border-right: 1px solid #444;
}

#TracksTitle {
    color: #d0d0d0;
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 1px;
}

#TracksCount {
    color: #8a8a8a;
    font-size: 11px;
}

#VolumeRowLabel {
    color: #9a9a9a;
    font-size: 10px;
    font-weight: bold;
}

#VolumeDbLabel {
    color: #8a8a8a;
    font-size: 10px;
}

/* MASTER (audio) and METRO (metronome) volumes share a green→orange level
   gradient. The groove carries the full-width gradient; the unfilled (add-page)
   part is dimmed so it reads as a level meter. */
QSlider#MasterVolumeSlider::groove:horizontal,
QSlider#MetroVolumeSlider::groove:horizontal {
    height: 8px;
    border-radius: 4px;
    border: 1px solid #333;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3e8a3a, stop:0.7 #9bcf3a, stop:1 #e0a52e);
}

QSlider#MasterVolumeSlider::add-page:horizontal,
QSlider#MetroVolumeSlider::add-page:horizontal {
    background: rgba(18, 18, 18, 190);
    border-radius: 4px;
}

QSlider#MasterVolumeSlider::sub-page:horizontal,
QSlider#MetroVolumeSlider::sub-page:horizontal {
    background: transparent;
}

/* No visible knob — the gradient fill alone shows the level. The handle stays
   present (width > 0) so the groove is still click/drag-able. */
QSlider#MasterVolumeSlider::handle:horizontal,
QSlider#MetroVolumeSlider::handle:horizontal {
    background: transparent;
    border: none;
    width: 6px;
    margin: 0;
}

/* DMX Display Table */
QTableWidget {
    background-color: #2B2B2B;
    color: white;
    gridline-color: #444444;
    border: 1px solid #444444;
    alternate-background-color: #333333;
    selection-background-color: #3a5a67;
}

QTableWidget::item {
    padding: 4px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #3a5a67;
    color: white;
}

QHeaderView::section {
    background-color: #3A3A3A;
    color: white;
    padding: 4px 8px;
    border: 1px solid #444444;
    font-weight: bold;
}

QHeaderView::section:horizontal {
    border-left: none;
}

QHeaderView::section:vertical {
    border-top: none;
}

/* Toolbar */
QToolBar {
    background-color: #2b2b2b;
    border: none;
    spacing: 5px;
    padding: 5px;
}

/* Toolbar Sections */
QFrame#ToolbarSection {
    background-color: #363636;
    border: 1px solid #555;
    border-radius: 8px;
    margin: 2px;
}

/* Section Titles */
QLabel#SectionTitle {
    background-color: #2b2b2b;
    border-radius: 6px;
    color: #aaa;
    font-size: 14px;
    font-weight: bold;
}

QLabel#SubsectionLabel {
    background-color: #3a3a3a;
    color: #aaa;
    font-size: 12px;
    font-weight: normal;
}

QLabel#SmallLabel {
    color: #aaa;
    font-size: 12px;
}

/* Load Buttons */
QPushButton#LoadButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#LoadButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#LoadButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* Import Bundle Button (darker, flat — visually distinct from siblings) */
QPushButton#ImportButton {
    background-color: #2f2f2f;
    color: #cfcfcf;
    border: 1px solid #262626;
    border-top: 1px solid #454545;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#ImportButton:hover {
    background-color: #383838;
}

QPushButton#ImportButton:pressed {
    background-color: #2a2a2a;
}

/* New Button */
QPushButton#NewButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #48803f, stop:1 #3c6e35);
    color: #eafbe6;
    border: 1px solid #2b4f26;
    border-top: 1px solid #5d9a4f;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#NewButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #52914a, stop:1 #447c3d);
}
QPushButton#NewButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3c6e35, stop:1 #2f5a29);
}

/* Export Button */
QPushButton#ExportButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#ExportButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#ExportButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

QPushButton#ExportButton:disabled {
    background: #333;
    color: #666;
    border-color: #444;
    border-top-color: #444;
}

/* Export Bundle Button (amber-accented primary export) */
QPushButton#ExportBundleButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4a3f31, stop:1 #3d3327);
    color: #f4e9db;
    border: 1px solid #6d5330;
    border-top: 1px solid #a07a41;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#ExportBundleButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #574a38, stop:1 #473b2c);
    border-top-color: #c1954f;
}

QPushButton#ExportBundleButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3d3327, stop:1 #322a20);
}

/* Playlist Navigation Buttons */
QPushButton#NavButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#NavButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

QPushButton#NavButton:disabled {
    background: #333;
    color: #555;
    border-color: #444;
    border-top-color: #444;
}

/* Remove Song Button */
QPushButton#RemoveButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #d98a8a;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    font-size: 14px;
}

QPushButton#RemoveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
    color: #e89a9a;
}

QPushButton#RemoveButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* Toolbar Hamburger Menu Button */
QToolButton#MenuButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: #e6e6e6;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 6px;
    padding: 0;
    font-weight: bold;
}

QToolButton#MenuButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QToolButton#MenuButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

/* Hide the default popup-indicator arrow — the ☰ glyph is enough. */
QToolButton#MenuButton::menu-indicator {
    image: none;
    width: 0;
    height: 0;
}

/* File Labels */
QLabel#FileLabel {
    background-color: #2b2b2b;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 2px 12px;
    font-size: 11px;
}

/* SHOW section: header, autosave state, show name and footer stats */
QLabel#ShowSectionTitle {
    background: transparent;
    color: #9a9a9a;
    font-size: 11px;
    font-weight: bold;
}

QLabel#AutosaveStatus {
    background: transparent;
    font-size: 11px;
}

QLabel#ShowNameLabel {
    background: transparent;
    color: #f0f0f0;
    font-size: 14px;
}

QLabel#ShowStatsLabel {
    background: transparent;
    color: #8a8a8a;
    font-size: 10px;
}

/* SETLIST section: unified song selector (counter badge + combobox) */
QFrame#SetlistSelector {
    background-color: #1e1e1e;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
}

QLabel#SetlistCounter {
    background-color: #2d4a63;
    color: #cfe4f5;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}

QComboBox#SetlistCombo {
    background: transparent;
    border: none;
    color: #f0f0f0;
    font-size: 13px;
    font-weight: bold;
    padding: 2px 4px;
}

QComboBox#SetlistCombo QLineEdit {
    background: transparent;
    border: none;
    color: #f0f0f0;
    font-weight: bold;
}

QComboBox#SetlistCombo::drop-down {
    border: none;
    width: 18px;
}

QComboBox#SetlistCombo QAbstractItemView {
    background-color: #262626;
    border: 1px solid #4a4a4a;
    color: #e6e6e6;
    selection-background-color: #2d4a63;
    outline: none;
}

/* SETLIST footer: BPM / offset / linked chip */
QLabel#BpmLabel {
    background: transparent;
    color: #6fce7f;
    font-size: 11px;
    font-weight: bold;
}

QLabel#OffsetLabel {
    background: transparent;
    color: #8a8a8a;
    font-size: 11px;
}

QLabel#LinkedChip {
    background: transparent;
    font-size: 11px;
}

/* SONG FILES: leading file-type icon */
QLabel#FileTypeIcon {
    background: transparent;
    font-size: 13px;
}

/* VERSIONS section: snapshot picker, History link and Snapshot action */
QComboBox#VersionsCombo {
    background-color: #1e1e1e;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    color: #e6e6e6;
    font-size: 12px;
    padding: 2px 8px;
}

QComboBox#VersionsCombo::drop-down {
    border: none;
    width: 18px;
}

QComboBox#VersionsCombo QAbstractItemView {
    background-color: #262626;
    border: 1px solid #4a4a4a;
    color: #e6e6e6;
    selection-background-color: #2d4a63;
    outline: none;
}

QPushButton#SnapshotButton {
    background-color: #2f2f2f;
    color: #d7d7d7;
    border: 1px solid #3a4a5a;
    border-radius: 5px;
    padding: 2px 12px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#SnapshotButton:hover {
    background-color: #384555;
    border-color: #4a6076;
}

QPushButton#SnapshotButton:pressed {
    background-color: #2a2a2a;
}

/* Transport Buttons */
QPushButton#StopButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4f4f4f, stop:1 #444);
    color: white;
    border: 1px solid #2c2c2c;
    border-top: 1px solid #5d5d5d;
    border-radius: 5px;
    padding: 4px;
}

QPushButton#StopButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #585858, stop:1 #4d4d4d);
}

QPushButton#StopButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #404040, stop:1 #3a3a3a);
}

QPushButton#PlayPauseButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5ad36a, stop:1 #37ad48);
    color: white;
    border: 1px solid #2c7a36;
    border-radius: 5px;
}

QPushButton#PlayPauseButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #63dd73, stop:1 #3dbb50);
}

QPushButton#PlayPauseButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4bc35b, stop:1 #2f9a40);
}

/* Time Display */
QLabel#TimeDisplay {
    background-color: #1a1a1a;
    color: #46e05a;
    border: 2px solid #333;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: bold;
}

/* Line Edits */
QLineEdit {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QLineEdit:focus {
    border-color: #555;
}

/* BPM Spinbox */
QSpinBox, QDoubleSpinBox {
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 0px;
    font-size: 12px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #555;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #1a1a1a;
    /*border: 1px solid #444;*/
    padding-right: 10px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #444;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url('assets/icons/up-arrow.png');
    width: 11px;
    height: 11px;
    color: white;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url('assets/icons/dropdown-arrow.png');
    width: 11px;
    height: 11px;
    color: white;
}

/* Checkboxes — dark bordered box, blue fill + white check when on */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #555;
    border-radius: 4px;
    background-color: #1a1a1a;
}

QCheckBox::indicator:hover {
    border-color: #777;
}

QCheckBox::indicator:checked {
    background-color: #5e9ec2;
    border-color: #5e9ec2;
    image: url('assets/icons/checkmark.png');
}

QCheckBox::indicator:checked:hover {
    background-color: #79cdf0;
    border-color: #79cdf0;
}

QCheckBox::indicator:disabled {
    background-color: #222;
    border-color: #3a3a3a;
}

QCheckBox::indicator:checked:disabled {
    background-color: #3a5a67;
    border-color: #3a5a67;
}

/* Radio buttons — dark bordered circle, blue fill + white dot when on */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #555;
    border-radius: 9px;
    background-color: #1a1a1a;
}

QRadioButton::indicator:hover {
    border-color: #777;
}

QRadioButton::indicator:checked {
    image: url('assets/icons/radio-dot.png');
}

QRadioButton::indicator:checked:hover {
}

QRadioButton::indicator:disabled {
    background-color: #222;
    border-color: #3a3a3a;
}

QRadioButton::indicator:checked:disabled {
    border-color: #3a5a67;
}

/* ComboBoxes */
QComboBox {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #3f3f3f;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 12px;
}

QComboBox:hover {
    border-color: #555;
}

QComboBox:focus {
    border-color: #79cdf0;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
    width: 22px;
    padding-right: 6px;
}

QComboBox::down-arrow {
    image: url('assets/icons/dropdown-arrow.png');
    width: 11px;
    height: 11px;
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #555;
    selection-background-color: #3a5a67;
}

QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border: none;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #3a5a67;
    color: white;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #4a6b78;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #2b2b2b;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #555;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #666;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #2b2b2b;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #555;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #666;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* DMX Side Panel Toggle (floating overlay on stage view) */
QPushButton#DmxPanelToggle {
    background-color: rgba(40, 40, 40, 200);
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 4px;
    font-weight: bold;
    padding: 0;
}

QPushButton#DmxPanelToggle:hover {
    background-color: rgba(70, 70, 70, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#DmxPanelToggle:pressed {
    background-color: rgba(20, 20, 20, 230);
}

/* Right Sidebar (Tabbed: Library + DMX Channels) */
QTabWidget#RightSidebar::pane {
    border: 1px solid #1f1f1f;
    background-color: #2b2b2b;
    top: -1px;
}

QTabWidget#RightSidebar QTabBar {
    qproperty-drawBase: 0;
}

QTabWidget#RightSidebar QTabBar::tab {
    background-color: #2b2b2b;
    color: #aaa;
    padding: 6px 14px;
    border: 1px solid #1f1f1f;
    font-size: 12px;
    font-weight: normal;
    min-width: 80px;
}

QTabWidget#RightSidebar QTabBar::tab:hover {
    background-color: #3a3a3a;
    color: #fff;
}

QTabWidget#RightSidebar QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #fff;
    border-color: #666;
    font-weight: bold;
    border-bottom: 2px solid #79cdf0;
}

QTabWidget#RightSidebar QTabBar::tab:!selected {
    margin-top: 2px;
}

/* DMX Channels — segmented USED/FULL toggle + universe indicator */
QWidget#DmxDisplay {
    background-color: #2b2b2b;
}

QPushButton#DmxSeg {
    background-color: #3a3a3a;
    color: #cfcfcf;
    border: 1px solid #1f1f1f;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: normal;
}

QPushButton#DmxSeg[pos="left"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-right: none;
}

QPushButton#DmxSeg[pos="right"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QPushButton#DmxSeg:hover {
    background-color: #454545;
    color: #fff;
}

QPushButton#DmxSeg:checked {
    background-color: #e6e6e6;
    color: #1e1e1e;
    font-weight: bold;
}

QLabel#DmxUniverse {
    color: #cfcfcf;
    font-size: 11px;
    padding-right: 4px;
}

/* Clip Library — Container */
QWidget#ClipLibrary {
    background-color: #2b2b2b;
}

/* Clip Library — Search row */
QWidget#ClipSearchRow {
    background-color: transparent;
}

QLineEdit#ClipSearchBox {
    background-color: #1a1a1a;
    color: #ddd;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
}

QLineEdit#ClipSearchBox:focus {
    border-color: #79cdf0;
}

QToolButton#ClipViewToggle {
    background-color: #1a1a1a;
    color: #aaa;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 4px 7px;
    font-size: 13px;
}

QToolButton#ClipViewToggle:hover {
    color: #fff;
    border-color: #666;
}

QToolButton#ClipViewToggle:checked {
    background-color: #3a3a3a;
    color: #cfe9f5;
    border-color: #666;
}

/* Clip Library — Group pills */
QWidget#ClipPillBar {
    background-color: transparent;
}

QFrame#ClipPill {
    background-color: #383838;
    border: 1px solid #444;
    border-radius: 6px;
}

QFrame#ClipPill:hover {
    background-color: #4a4a4a;
    border-color: #666;
}

QFrame#ClipPill[selected="true"] {
    background-color: #5e9ec2;
    border-color: #5e9ec2;
}

QLabel#ClipPillLabel {
    color: #ddd;
    font-size: 11px;
    font-weight: normal;
    background: transparent;
}

QFrame#ClipPill[selected="true"] QLabel#ClipPillLabel {
    color: #082230;
    font-weight: bold;
}

QLabel#ClipPillCount {
    color: #999;
    border-radius: 7px;
    /*padding: 0 4px;*/
    font-size: 9px;
    font-weight: normal;
}

QFrame#ClipPillNew {
    background-color: transparent;
    border: 1px dashed #666;
    border-radius: 12px;
}

QFrame#ClipPillNew QLabel#ClipPillLabel {
    color: #888;
    font-weight: normal;
}

/* Clip Library — Group header */
QWidget#ClipHeaderRow {
    background-color: transparent;
}

QLabel#ClipGroupHeader {
    color: #bbb;
    font-size: 12px;
    font-weight: bold;
    margin-top: 10px;
}

QLabel#ClipSortLabel {
    color: #888;
    font-size: 11px;
}

/* Clip Library — Clip cards */
QScrollArea#ClipCardScroll {
    background-color: transparent;
    border: none;
}

QWidget#ClipCardGrid {
    background-color: transparent;
}

QFrame#ClipCard {
    background-color: #262626;
    border: 1px solid #1c1c1c;
    border-radius: 5px;
}

QFrame#ClipCard:hover {
    background-color: #24323a;
    border-color: #4a7d92;
}

QLabel#ClipCardTitle {
    color: #eee;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#ClipCardType {
    color: #888;
    font-size: 10px;
    background: transparent;
}

QLabel#ClipLibraryPlaceholder {
    color: #888;
    font-size: 12px;
}

/* Scene Edit — Animation grid tiles */
QFrame#AnimationTile {
    background-color: #1a1a1a;
    border: 1px solid #444;
    border-radius: 4px;
}

QFrame#AnimationTile:hover {
    border-color: #888;
}

QFrame#AnimationTile[selected="true"] {
    border: 2px solid #79cdf0;
    background-color: #24414d;
}

/* Scene Edit — Brightness slider (black → white gradient groove) */
QSlider#BrightnessSlider::groove:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #000000, stop:1 #ffffff);
    height: 10px;
    border: 1px solid #555;
    border-radius: 5px;
}

QSlider#BrightnessSlider::handle:horizontal {
    background: #d0d0d0;
    border: 1px solid #222;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider#BrightnessSlider::handle:horizontal:hover {
    background: #ffffff;
}

/* START Event Edit Dialog */
QLabel#PaletteSectionHeader,
QLabel#PaletteModeHeader {
    font-weight: bold;
}

QLabel#PaletteModeHeader {
    margin-top: 8px;
}

QLabel#RandomHueLabel {
    color: #888;
    font-size: 10px;
}

QPushButton#RandomHueButton {
    background-color: #2a2a2a;
    color: #dddddd;
    border: 2px solid #555;
    border-radius: 4px;
    font-size: 22px;
    font-weight: bold;
}

QPushButton#RandomHueButton:checked {
    border: 3px solid white;
}

QPushButton#PaletteModeButton {
    padding: 8px;
    border: 2px solid #555;
    border-radius: 4px;
}

QPushButton#PaletteModeButton:checked {
    border: 3px solid white;
    background-color: #444;
}

/* Color swatch border/checked styling; the per-swatch fill is set in code. */
QPushButton#ColorSwatch {
    border: 2px solid #555;
    border-radius: 4px;
}

QPushButton#ColorSwatch:checked {
    border: 3px solid white;
}

/* Timeline track-header "A" (auto) toggle — green while following the
   song-part program, matching the play button's accent. */
QPushButton#AutoModeButton {
    background-color: #2a2a2a;
    color: #cccccc;
    border: 1px solid #555;
    border-radius: 3px;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#AutoModeButton:hover {
    background-color: #3a3a3a;
    border-color: #777;
}

QPushButton#AutoModeButton:checked {
    background-color: #43c556;
    color: white;
    border: 1px solid #3ba84a;
}

QPushButton#AutoModeButton:checked:hover {
    background-color: #3bbf4d;
}

QPushButton#AutoModeButton:disabled {
    background-color: #222;
    color: #555;
    border-color: #333;
}

/* ---- Timeline track-header (TrackHeaderWidget) ---- */

/* Fixture name + MIDI/DMX address, stacked next to the swatch. */
QLabel#TrackName {
    color: #eaeaea;
    font-weight: bold;
    font-size: 16px;
}

QLabel#TrackInfo {
    color: #8a8a8a;
    font-size: 10px;
}

/* Reorder grip (placeholder) + collapse chevron — frameless; the chevron
   collapses the track and swaps its glyph rather than showing a checked fill. */
QPushButton#TrackGrip,
QPushButton#TrackChevron {
    background-color: transparent;
    border: none;
    color: #8a8a8a;
    font-size: 13px;
}

QPushButton#TrackChevron:hover {
    background-color: #3a3a3a;
    border-radius: 3px;
}

/* Eye (mute) + lock toggles — same frame as the "A" button; the UTF glyph is
   set as the button text (see TrackHeaderWidget). */
QPushButton#TrackEyeButton,
QPushButton#TrackLockButton {
    background-color: #2a2a2a;
    border: 1px solid #555;
    border-radius: 3px;
    font-size: 12px;
}

QPushButton#TrackEyeButton:hover,
QPushButton#TrackLockButton:hover {
    background-color: #3a3a3a;
    border-color: #777;
}

/* Muted: warm amber highlight. */
QPushButton#TrackEyeButton:checked {
    background-color: #6b4a1f;
    border: 1px solid #a5742c;
}

QPushButton#TrackEyeButton:checked:hover {
    background-color: #7c561f;
}

/* Locked: gold fill (the glyph also swaps to a closed padlock). */
QPushButton#TrackLockButton:checked {
    background-color: #c9a227;
    border: 1px solid #b08f1f;
}

QPushButton#TrackLockButton:checked:hover {
    background-color: #d4ac2c;
}

/* General Widget Styling */
QWidget {
    color: #dcdcdc;
    font-family: "Helvetica Neue";
}

QLabel {
    color: #dcdcdc;
}

/* Stage scenario designer — "Edit stage" trigger + top-left edit toolbar */
QPushButton#EditStageButton {
    background-color: rgba(40, 40, 40, 200);
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton#EditStageButton:hover {
    background-color: rgba(70, 70, 70, 220);
    border-color: rgba(255, 255, 255, 140);
}

QPushButton#EditStageButton:pressed {
    background-color: rgba(20, 20, 20, 230);
}

QWidget#StageEditToolbar {
    background-color: rgba(28, 28, 28, 235);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 8px;
}

QLabel#EditModeLabel {
    color: white;
    font-weight: bold;
    padding: 0 4px;
}

QWidget#StageEditToolbar QPushButton {
    color: white;
    background-color: #4a4a4a;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 5px;
    padding: 6px 12px;
    font-weight: bold;
}

QWidget#StageEditToolbar QPushButton:hover {
    background-color: #5a5a5a;
}

QWidget#StageEditToolbar QPushButton:disabled {
    color: #777;
    background-color: #3a3a3a;
    border-color: rgba(255, 255, 255, 20);
}

QWidget#StageEditToolbar QPushButton#EditToolbarAdd {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3c6e8a, stop:1 #2f5a72);
    border: 1px solid #1f4255;
    border-top: 1px solid #4d87a4;
    color: #eaf7fd;
}

QWidget#StageEditToolbar QPushButton#EditToolbarAdd:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #47809e, stop:1 #3a6d88);
}

QWidget#StageEditToolbar QPushButton#EditToolbarDone {
    background-color: #79cdf0;
    border-color: #5fb4d8;
    color: #082230;
}

QWidget#StageEditToolbar QPushButton#EditToolbarDone:hover {
    background-color: #8fd6f3;
}

/* Fixture inspector — floating card for the selected fixture */
QWidget#FixtureInspector {
    background-color: rgba(28, 28, 28, 240);
    border: 1px solid rgba(255, 255, 255, 45);
    border-radius: 8px;
}

QLabel#InspectorTitle {
    color: white;
    font-size: 15px;
    font-weight: bold;
}

QPushButton#InspectorClose {
    background-color: transparent;
    color: #aaa;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#InspectorClose:hover {
    color: white;
}

QLabel#InspectorSection {
    color: #8a8a8a;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    margin-top: 6px;
}

QLabel#InspectorFieldLabel {
    color: #bbb;
    font-size: 11px;
}

QLabel#InspectorReadonly {
    color: white;
    background-color: #333;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 4px;
    padding: 5px 8px;
}

QWidget#FixtureInspector QLineEdit,
QWidget#FixtureInspector QSpinBox {
    color: white;
    background-color: #3a3a3a;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 4px;
    padding: 5px 8px;
}

QWidget#FixtureInspector QLineEdit:focus,
QWidget#FixtureInspector QSpinBox:focus {
    border-color: #79cdf0;
}

QPushButton#InspectorDelete {
    color: #ff8a8a;
    background-color: rgba(120, 40, 40, 200);
    border: 1px solid #a04040;
    border-radius: 5px;
    padding: 7px 12px;
    font-weight: bold;
}

QPushButton#InspectorDelete:hover {
    background-color: rgba(150, 50, 50, 220);
    color: white;
}

QPushButton#InspectorDelete:pressed {
    background-color: rgba(100, 30, 30, 230);
}

/* ============================================================
   Timeline toolbar (strip above the timeline tracks)
   Transport widgets reuse #StopButton/#PlayPauseButton/
   #TimeDisplay/#MetronomeButton styles defined above.
   ============================================================ */
QWidget#TimelineToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #303030, stop:1 #2a2a2a);
    border-top: 2px solid #181818;
    border-bottom: 1px solid #181818;
}

QFrame#TTSeparator {
    color: rgba(255, 255, 255, 30);
    max-width: 1px;
    margin: 4px 4px;
}

QLabel#TTRowsLabel {
    color: #aaa;
    padding: 0 2px;
}

/* Generic tool buttons + Add track */
QWidget#TimelineToolbar QPushButton#TTToolButton,
QWidget#TimelineToolbar QPushButton#TTAddTrack,
QWidget#TimelineToolbar QPushButton#TTFit {
    color: #e0e0e0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3d3d3d, stop:1 #333);
    border: 1px solid #1d1d1d;
    border-top: 1px solid #454545;
    border-radius: 5px;
    padding: 5px 10px;
}

QWidget#TimelineToolbar QPushButton#TTToolButton:hover,
QWidget#TimelineToolbar QPushButton#TTAddTrack:hover,
QWidget#TimelineToolbar QPushButton#TTFit:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #464646, stop:1 #3c3c3c);
}

QWidget#TimelineToolbar QPushButton#TTAddTrack {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3c6e8a, stop:1 #2f5a72);
    border: 1px solid #1f4255;
    border-top: 1px solid #4d87a4;
    color: #eaf7fd;
    font-weight: bold;
}

QWidget#TimelineToolbar QPushButton#TTAddTrack:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #47809e, stop:1 #3a6d88);
}

/* Snap toggle */
QWidget#TimelineToolbar QPushButton#TTSnap {
    color: #e0e0e0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3d3d3d, stop:1 #333);
    border: 1px solid #1d1d1d;
    border-top: 1px solid #454545;
    border-radius: 5px;
    padding: 5px 10px;
}

QWidget#TimelineToolbar QPushButton#TTSnap:checked {
    color: white;
    background-color: #43c556;
    border: 1px solid #3ba84a;
    font-weight: bold;
}

/* Segmented toggles (Bars|Time, Rows S/M/L) */
QWidget#TimelineToolbar QPushButton#TTSegment {
    color: #cfcfcf;
    background-color: #333;
    border: 1px solid #444;
    padding: 5px 2px;
}

QWidget#TimelineToolbar QPushButton#TTSegment:checked {
    color: white;
    background-color: #4a4a4a;
    border-color: #5a5a5a;
    font-weight: bold;
}

/* Round only the outer corners of the segmented control */
QWidget#TimelineToolbar QPushButton#TTSegment[seg="left"] {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

QWidget#TimelineToolbar QPushButton#TTSegment[seg="right"] {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

/* Zoom slider */
QSlider#TTZoom::groove:horizontal {
    background: #1a1a1a;
    height: 6px;
    border: 1px solid #444;
    border-radius: 3px;
}

QSlider#TTZoom::handle:horizontal {
    background: #d0d0d0;
    border: 1px solid #222;
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

QSlider#TTZoom::handle:horizontal:hover {
    background: #ffffff;
}

/* ============================================================
   Settings dialog — Input / Output page
   Numbered routing cards, quick-mode strip, signal-flow panel.
   Graph colours are painted in code (ui/io_flow_widget.py).
   ============================================================ */
QLabel#SettingsSectionTitle {
    color: #e0e0e0;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#SettingsHintLabel {
    color: #8a8a8a;
    font-size: 11px;
}

QFrame#SettingsCard, QFrame#SignalFlowPanel {
    background-color: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 10px;
}

/* Circled number badge — filled blue disc (radius = half the 22px set in code) */
QLabel#SettingsCardBadge {
    background-color: #79cdf0;
    color: #082230;
    border-radius: 11px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#SettingsCardTitle {
    background: transparent;
    color: #e0e0e0;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#SettingsCardSubtitle, QLabel#SettingsDimLabel {
    background: transparent;
    color: #8a8a8a;
    font-size: 11px;
}

QLabel#SettingsToggleLabel {
    background: transparent;
    color: #cfcfcf;
    font-size: 11px;
}

/* Controller-card body dims while its power toggle is off. */
QFrame#SettingsCard QLabel:disabled,
QFrame#SettingsCard QCheckBox:disabled,
QFrame#SettingsCard QRadioButton:disabled {
    color: #5f5f5f;
}

/* Live validation strip under the flow graph. */
QLabel#IOValidationLabel {
    background: transparent;
    font-size: 11px;
}

QLabel#IOValidationLabel[state="ok"] {
    color: #4CAF50;
}

QLabel#IOValidationLabel[state="warn"] {
    color: #d9a13b;
}

QLabel#IOValidationLabel[state="error"] {
    color: #e05252;
}