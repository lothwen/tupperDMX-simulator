{
  "$schema": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/fixture.json",
  "name": "moving-head",
  "shortName": "TDMXMHEAD",
  "categories": [
    "Moving Head",
    "Color Changer"
  ],
  "meta": {
    "authors": [
      "TupperDMX"
    ],
    "createDate": "2026-08-07",
    "lastModifyDate": "2026-08-07"
  },
  "comment": "A generic LED spot moving head: 540°/270° yoke, RGBW mixing, a gobo wheel, a 3-facet prism and a zoom. The gobo wheel is what makes its beam hard-edged; the RGBW mixing is what lets the colour palettes reach it.",
  "physical": {
    "dimensions": [
      150,
      220,
      120
    ],
    "weight": 12.5,
    "power": 200,
    "DMXconnector": "3-pin and 5-pin",
    "bulb": {
      "type": "1x 200 W RGBW LED"
    },
    "lens": {
      "degreesMinMax": [
        12,
        30
      ]
    }
  },
  "wheels": {
    "Gobo Wheel": {
      "slots": [
        {
          "type": "Open"
        },
        {
          "type": "Gobo",
          "name": "Breakup",
          "resource": "gobos/breakup"
        },
        {
          "type": "Gobo",
          "name": "Dots",
          "resource": "gobos/dots"
        },
        {
          "type": "Gobo",
          "name": "Lines",
          "resource": "gobos/lines"
        },
        {
          "type": "Gobo",
          "name": "Star",
          "resource": "gobos/star"
        },
        {
          "type": "Gobo",
          "name": "Spiral",
          "resource": "gobos/spiral"
        },
        {
          "type": "Gobo",
          "name": "Triangles",
          "resource": "gobos/triangles"
        },
        {
          "type": "Closed"
        }
      ]
    },
    "Prism": {
      "slots": [
        {
          "type": "Open"
        },
        {
          "type": "Prism",
          "name": "3-facet prism",
          "facets": 3
        }
      ]
    }
  },
  "availableChannels": {
    "Pan": {
      "fineChannelAliases": [
        "Pan fine"
      ],
      "defaultValue": "50%",
      "capability": {
        "type": "Pan",
        "angleStart": "0deg",
        "angleEnd": "540deg"
      }
    },
    "Tilt": {
      "fineChannelAliases": [
        "Tilt fine"
      ],
      "defaultValue": "50%",
      "capability": {
        "type": "Tilt",
        "angleStart": "0deg",
        "angleEnd": "270deg"
      }
    },
    "Pan/Tilt Speed": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 0],
          "type": "PanTiltSpeed",
          "speed": "fast",
          "comment": "Maximum speed"
        },
        {
          "dmxRange": [1, 255],
          "type": "PanTiltSpeed",
          "speedStart": "fast",
          "speedEnd": "slow"
        }
      ]
    },
    "Dimmer": {
      "defaultValue": 0,
      "capability": {
        "type": "Intensity"
      }
    },
    "Shutter": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 7],
          "type": "ShutterStrobe",
          "shutterEffect": "Closed",
          "comment": "Blackout"
        },
        {
          "dmxRange": [8, 15],
          "type": "ShutterStrobe",
          "shutterEffect": "Open"
        },
        {
          "dmxRange": [16, 131],
          "type": "ShutterStrobe",
          "shutterEffect": "Strobe",
          "speedStart": "slow",
          "speedEnd": "fast"
        },
        {
          "dmxRange": [132, 167],
          "type": "ShutterStrobe",
          "shutterEffect": "Pulse",
          "speedStart": "slow",
          "speedEnd": "fast"
        },
        {
          "dmxRange": [168, 203],
          "type": "ShutterStrobe",
          "shutterEffect": "RampUp",
          "speedStart": "slow",
          "speedEnd": "fast"
        },
        {
          "dmxRange": [204, 239],
          "type": "ShutterStrobe",
          "shutterEffect": "Strobe",
          "randomTiming": true,
          "speedStart": "slow",
          "speedEnd": "fast"
        },
        {
          "dmxRange": [240, 255],
          "type": "ShutterStrobe",
          "shutterEffect": "Open"
        }
      ]
    },
    "Red": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Red"
      }
    },
    "Green": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Green"
      }
    },
    "Blue": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "Blue"
      }
    },
    "White": {
      "defaultValue": 0,
      "capability": {
        "type": "ColorIntensity",
        "color": "White"
      }
    },
    "Gobo Wheel": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 15],
          "type": "WheelSlot",
          "slotNumber": 1
        },
        {
          "dmxRange": [16, 31],
          "type": "WheelSlot",
          "slotNumber": 2
        },
        {
          "dmxRange": [32, 47],
          "type": "WheelSlot",
          "slotNumber": 3
        },
        {
          "dmxRange": [48, 63],
          "type": "WheelSlot",
          "slotNumber": 4
        },
        {
          "dmxRange": [64, 79],
          "type": "WheelSlot",
          "slotNumber": 5
        },
        {
          "dmxRange": [80, 95],
          "type": "WheelSlot",
          "slotNumber": 6
        },
        {
          "dmxRange": [96, 111],
          "type": "WheelSlot",
          "slotNumber": 7
        },
        {
          "dmxRange": [112, 127],
          "type": "WheelSlot",
          "slotNumber": 8,
          "comment": "Gobo blackout"
        },
        {
          "dmxRange": [128, 191],
          "type": "WheelShake",
          "slotNumberStart": 2,
          "slotNumberEnd": 7,
          "shakeSpeedStart": "slow",
          "shakeSpeedEnd": "fast"
        },
        {
          "dmxRange": [192, 255],
          "type": "WheelRotation",
          "speedStart": "slow CW",
          "speedEnd": "fast CW",
          "comment": "Continuous wheel scroll"
        }
      ]
    },
    "Gobo Rotation": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 127],
          "type": "WheelSlotRotation",
          "wheel": "Gobo Wheel",
          "angleStart": "0deg",
          "angleEnd": "360deg"
        },
        {
          "dmxRange": [128, 191],
          "type": "WheelSlotRotation",
          "wheel": "Gobo Wheel",
          "speedStart": "slow CW",
          "speedEnd": "fast CW"
        },
        {
          "dmxRange": [192, 255],
          "type": "WheelSlotRotation",
          "wheel": "Gobo Wheel",
          "speedStart": "fast CCW",
          "speedEnd": "slow CCW"
        }
      ]
    },
    "Prism": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 127],
          "type": "NoFunction",
          "comment": "Prism out"
        },
        {
          "dmxRange": [128, 255],
          "type": "Prism"
        }
      ]
    },
    "Prism Rotation": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 127],
          "type": "PrismRotation",
          "angleStart": "0deg",
          "angleEnd": "360deg"
        },
        {
          "dmxRange": [128, 191],
          "type": "PrismRotation",
          "speedStart": "slow CW",
          "speedEnd": "fast CW"
        },
        {
          "dmxRange": [192, 255],
          "type": "PrismRotation",
          "speedStart": "fast CCW",
          "speedEnd": "slow CCW"
        }
      ]
    },
    "Zoom": {
      "defaultValue": 128,
      "capability": {
        "type": "Zoom",
        "angleStart": "12deg",
        "angleEnd": "30deg"
      }
    },
    "Focus": {
      "defaultValue": 128,
      "capability": {
        "type": "Focus",
        "distanceStart": "near",
        "distanceEnd": "far"
      }
    },
    "Control": {
      "defaultValue": 0,
      "capabilities": [
        {
          "dmxRange": [0, 199],
          "type": "NoFunction"
        },
        {
          "dmxRange": [200, 219],
          "type": "Maintenance",
          "comment": "Reset pan/tilt",
          "hold": "5s"
        },
        {
          "dmxRange": [220, 239],
          "type": "Maintenance",
          "comment": "Reset wheels",
          "hold": "5s"
        },
        {
          "dmxRange": [240, 255],
          "type": "Maintenance",
          "comment": "Reset all",
          "hold": "5s"
        }
      ]
    }
  },
  "modes": [
